# Additional local discovery links for names outside the small genre catalog.
RELATED_ARTISTS = {
    "Карандаш": ["Каста","Смоки Мо","ГРОТ","Кравц","Змей"],
    "ГРОТ": ["Карандаш","25/17","Каста","Смоки Мо","Noize MC"],
    "25/17": ["ГРОТ","Карандаш","Каста","Порнофильмы"],
}


def artist_direction_index():
    index={}
    for direction,artists in subgenre_catalog().items():
        for artist in artists:index.setdefault(normalized(artist),[]).append(direction)
    for parent,artists in GENRES.items():
        for artist in artists:index.setdefault(normalized(artist),[]).append(parent)
    for root,links in RELATED_ARTISTS.items():
        key=normalized(root)
        if key not in index:
            names={normalized(a) for a in links}
            votes={parent:sum(normalized(a) in names for a in artists) for parent,artists in GENRES.items()}
            if votes and max(votes.values())>0:index[key]=[max(votes,key=votes.get)]
    return index


def track_direction(track,index=None):
    """Catalog inference only: unrelated personal preferences are not evidence."""
    names=artist_names(track.get("artist",""))
    index=artist_direction_index() if index is None else index
    for name in names:
        options=index.get(normalized(name),[])
        children=[direction for direction in options if "/" in direction]
        parents=[direction for direction in options if "/" not in direction]
        if children:
            previous=str(track.get("genre","")).split("/",1)[0]
            return next((d for d in children if d.split("/",1)[0]==previous),children[0])
        if parents:return parents[0]
    return ""


def collection_wave_profile(ids,collection,fallback=""):
    """Read every member's metadata, without decoding thousands of Java objects.

    Bounded square-root weights keep a large album dump from dominating a small
    selection of other artists. Discovery stays inside this collection's roots.
    """
    catalog=subgenre_catalog()
    if fallback not in GENRES and fallback not in catalog:fallback=""
    index=artist_direction_index()
    tracks=collection.data["tracks"]
    members=list(dict.fromkeys(str(key) for key in ids if str(key) in tracks))
    excluded={fingerprint(tracks[key]) for key in members}
    roots={};direction_votes={};directions={};cache={}
    unknown={normalized(x) for x in ("Неизвестный исполнитель","Unknown artist","Unknown")}
    for key in members:
        track=tracks[key]
        for name in artist_names(track.get("artist","")):
            normalized_name=normalized(name)
            if not normalized_name or normalized_name in unknown:continue
            previous=roots.get(normalized_name,(name,0))
            roots[normalized_name]=(previous[0],previous[1]+1)
            lookup=(normalized_name,str(track.get("genre","")))
            if lookup not in cache:cache[lookup]=track_direction({"artist":name,"genre":lookup[1]},index) or fallback
            direction=cache[lookup]
            if direction:
                votes=direction_votes.setdefault(normalized_name,{})
                votes[direction]=votes.get(direction,0)+1
    weights={key:(name,5.0+min(2.0,count**0.5)) for key,(name,count) in roots.items()}
    genre_votes={}
    for key,votes in direction_votes.items():
        direction=max(votes,key=votes.get)
        strength=min(2.0,roots[key][1]**0.5)
        directions[key]=direction.split("/",1)[0]
        artists=catalog[direction] if direction in catalog else list(GENRES[direction])+[a for values in SUBGENRES.get(direction,{}).values() for a in values]
        for name in dict.fromkeys(artists):
            normalized_name=normalized(name)
            if normalized_name not in roots:
                old=weights.get(normalized_name,(name,0.0))
                weights[normalized_name]=(old[0],min(5.0,old[1]+2.2*strength))
            scores=genre_votes.setdefault(normalized_name,{})
            parent=direction.split("/",1)[0]
            scores[parent]=scores.get(parent,0)+strength
    if not roots and fallback and members:
        artists=catalog[fallback] if fallback in catalog else list(GENRES[fallback])+[a for values in SUBGENRES.get(fallback,{}).values() for a in values]
        for name in dict.fromkeys(artists):
            key=normalized(name);weights[key]=(name,2.2);directions[key]=fallback.split("/",1)[0]
    for key,votes in genre_votes.items():
        if key not in directions:directions[key]=max(votes,key=votes.get)
    return {"ids":set(members),"count":len(members),"familiar":set(roots),"sources":list(weights.values()),"genres":directions,"excluded":excluded}


def track_wave_sources(track,direction,collection):
    """Keep a track wave rooted in its direction; taste only adjusts that pool."""
    parent=str(direction).split("/",1)[0]
    if parent not in GENRES:return []
    catalog=subgenre_catalog()
    if "/" in direction and direction not in catalog:return []
    weights={}
    def put(name,weight):
        key=normalized(name)
        if not key or key in {normalized(x) for x in ("Неизвестный исполнитель","Unknown artist","Unknown")} :return
        old=weights.get(key,(name,0.0))
        weights[key]=(old[0],max(old[1],weight))
    for name in artist_names(track.get("artist","")):put(name,5.0)
    artists=list(catalog[direction]) if direction in catalog else list(GENRES[parent])+[a for values in SUBGENRES.get(parent,{}).values() for a in values]
    for name in artists:put(name,2.2)
    eligible={normalized(a) for a in artists}
    roots={normalized(a) for a in artist_names(track.get("artist",""))}
    for root,related in RELATED_ARTISTS.items():
        if normalized(root) in roots:
            for name in related:
                if normalized(name) in eligible:put(name,2.6)
    familiar=collection.familiar_artists()
    result=[]
    for key,(name,weight) in weights.items():
        learned=max(-5.0,min(5.0,float(collection.data["scores"].get(key,{}).get("value",0))))
        result.append((name,weight*(1.08 if key in familiar else 1.0)*max(0.55,min(1.2,1+learned*0.04))))
    return result


def subgenre_key(parent,child):
    return str(parent)+"/"+str(child)


def subgenre_catalog():
    return {subgenre_key(parent,child):artists for parent,children in SUBGENRES.items() for child,artists in children.items()}


def clean_artists(values):
    result=[]
    seen=set()
    for value in values:
        if not isinstance(value,str):continue
        value=value.strip()[:80]
        key=normalized(value)
        if key and key not in seen:
            seen.add(key)
            result.append(value)
        if len(result)>=50:break
    return result


class WaveDraft:
    """A draft remains separate from saved preferences until Save is pressed."""
    def __init__(self,collection):
        self.artists=clean_artists(list(collection.data["seeds"]))
        self.genres=set(collection.data["genres"])
        self.subgenres=set(collection.data.get("subgenres",[]))
        self.hide_short=bool(collection.data["hidden_short"])

    def children(self,parent):
        return [subgenre_key(parent,child) for child in SUBGENRES.get(parent,{})]

    def parent_state(self,parent):
        if parent in self.genres:return "all"
        return "some" if any(key in self.subgenres for key in self.children(parent)) else "none"

    def toggle_parent(self,parent):
        if parent not in GENRES:return
        if parent in self.genres:self.genres.remove(parent)
        else:self.genres.add(parent)
        self.subgenres.difference_update(self.children(parent))

    def child_selected(self,parent,child):
        return parent in self.genres or subgenre_key(parent,child) in self.subgenres

    def toggle_child(self,parent,child):
        key=subgenre_key(parent,child)
        if key not in self.children(parent):return
        if parent in self.genres:
            self.genres.remove(parent)
            self.subgenres.update(self.children(parent))
        if key in self.subgenres:self.subgenres.remove(key)
        else:self.subgenres.add(key)

    def apply(self,collection):
        collection.data["seeds"]=clean_artists(self.artists)
        collection.data["genres"]=[parent for parent in GENRES if parent in self.genres]
        catalog=subgenre_catalog()
        collection.data["subgenres"]=[key for key in catalog if key in self.subgenres and key.split("/",1)[0] not in self.genres]
        collection.data["hidden_short"]=self.hide_short


def artist_suggestions(owner,query,remote=()):
    catalog=[]
    data=owner.collection.data
    catalog.extend(data["seeds"])
    for key in data["liked"]:
        catalog.extend(artist_names(data["tracks"].get(key,{}).get("artist","")))
    for value in data["scores"].values():
        catalog.append(str(value.get("name","")))
    for stored in list(data["tracks"].values())[-150:]:
        catalog.extend(artist_names(stored.get("artist","")))
    catalog.extend(remote)
    for artists in GENRES.values():catalog.extend(artists)
    for artists in subgenre_catalog().values():catalog.extend(artists)
    query=normalized(query)
    seen=set()
    matches=[]
    for name in catalog:
        name=str(name).strip()
        key=normalized(name)
        if not key or key in seen or (query and query not in key):continue
        seen.add(key)
        score=0 if query and key==query else 1 if query and key.startswith(query) else 2
        matches.append((score,key,name))
    return [name for _,_,name in sorted(matches)][:16]


class ArtistQueryWatcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
    def __init__(self,picker):
        super().__init__()
        self.picker=picker
    def beforeTextChanged(self,text,start,count,after):pass
    def onTextChanged(self,text,start,before,count):self.picker.query_changed(str(text))
    def afterTextChanged(self,text):pass


class ArtistPicker:
    def __init__(self,screen,selected):
        self.screen,self.owner,self.context=screen,screen.owner,screen.context
        self.selected=clean_artists(list(selected))
        self.query,self.remote="",[]
        self.serial=0
        self.job=None
        self.closed=False
        self.listeners,self.chip_listeners,self.result_listeners=[],[],[]
        self.status="Начни вводить имя исполнителя"
        self.view=LinearLayout(self.context)
        self.view.setOrientation(1)
        self.view.setPadding(dp(14),dp(8),dp(14),dp(8))
        self.view.setBackgroundColor(screen.background)
        self.counter=screen.label("",13,True)
        self.counter.setPadding(0,0,0,dp(6))
        self.view.addView(self.counter)
        self.chips=LinearLayout(self.context)
        self.chips.setOrientation(1)
        self.chips_scroll=ScrollView(self.context)
        self.chips_scroll.setVerticalScrollBarEnabled(False)
        self.chips_scroll.addView(self.chips,ScrollView.LayoutParams(MATCH,WRAP))
        self.view.addView(self.chips_scroll,LinearLayout.LayoutParams(MATCH,WRAP))
        search=LinearLayout(self.context)
        search.setGravity(Gravity.CENTER_VERTICAL)
        search.setPadding(dp(8),0,dp(4),0)
        search.setBackground(screen.rounded(screen.surface,20))
        self.edit=EditText(self.context)
        self.edit.setTextColor(readable_ink(screen.surface,screen.foreground))
        self.edit.setHintTextColor(readable_ink(screen.surface,screen.muted,True))
        self.edit.setTextSize(16.0)
        self.edit.setTypeface(screen.fonts.get("body",Typeface.DEFAULT))
        self.edit.setSingleLine(True)
        self.edit.setHint("Найти исполнителя")
        self.edit.setPadding(dp(8),0,dp(4),0)
        self.edit.setBackgroundColor(0)
        self.watcher=ArtistQueryWatcher(self)
        self.edit.addTextChangedListener(self.watcher)
        search.addView(self.edit,LinearLayout.LayoutParams(0,dp(50),1.0))
        clear=screen.label("×",25,True)
        clear.setGravity(Gravity.CENTER)
        clear.setContentDescription("Очистить поиск исполнителей")
        self.click(clear,lambda:self.edit.setText(""),self.listeners)
        search.addView(clear,LinearLayout.LayoutParams(dp(40),dp(48)))
        self.view.addView(search,LinearLayout.LayoutParams(MATCH,WRAP))
        self.message=screen.label(self.status,12,True)
        self.message.setPadding(dp(4),dp(8),dp(4),dp(6))
        self.view.addView(self.message)
        results_scroll=ScrollView(self.context)
        self.results=LinearLayout(self.context)
        self.results.setOrientation(1)
        results_scroll.addView(self.results,ScrollView.LayoutParams(MATCH,WRAP))
        self.view.addView(results_scroll,LinearLayout.LayoutParams(MATCH,0,1.0))
        self.render_chips()
        self.render_results()

    def click(self,view,callback,storage):
        listener=OnClickListener(lambda v:callback() if not self.closed else None)
        storage.append(listener)
        view.setOnClickListener(listener)

    def avatar(self,name,size):
        view=self.screen.label("".join(part[0] for part in re.split(r"\s+",name.strip())[:2] if part).upper(),12 if size<35 else 15,bold=True)
        value=sum(ord(char) for char in normalized(name))
        view.setTextColor(-1)
        view.setGravity(Gravity.CENTER)
        tint=blend_color(self.screen.surface,self.screen.accent,0.35+(value%3)*0.08)
        view.setBackground(self.screen.rounded(tint,size/2))
        view.setTextColor(readable_ink(tint,self.screen.foreground))
        view.setContentDescription(name)
        return view

    def toggle(self,name):
        key=normalized(name)
        exists=next((artist for artist in self.selected if normalized(artist)==key),None)
        if exists is not None:self.selected.remove(exists)
        elif len(self.selected)<50:self.selected.append(str(name).strip()[:80])
        else:
            self.screen.notify("Можно выбрать до 50 исполнителей")
            return
        self.render_chips()
        self.render_results()

    def render_chips(self):
        self.chips.removeAllViews()
        self.chip_listeners.clear()
        self.counter.setText("Выбрано %d из 50"%len(self.selected))
        try:
            available=int(self.chips_scroll.getWidth())
            if available<=0:raise ValueError()
        except Exception:
            try:available=int(self.context.getResources().getDisplayMetrics().widthPixels)-dp(28)
            except Exception:available=dp(290)
        height=dp(44)
        try:
            metrics=self.screen.label("Аg",14).getPaint().getFontMetricsInt()
            height=max(height,int(metrics.bottom)-int(metrics.top)+dp(12))
        except Exception:pass
        gap=dp(6)
        row,used,row_count=None,0,0
        for name in self.selected:
            text=self.screen.label(name,14,on=self.screen.raised)
            text.setIncludeFontPadding(True)
            text.setMaxLines(1)
            text.setEllipsize(TruncateAt.END)
            text.setGravity(Gravity.CENTER_VERTICAL)
            try:width=int(text.getPaint().measureText(name))+1+dp(80)
            except Exception:width=dp(min(250,80+8*len(name)))
            width=min(max(dp(1),available-gap),width)
            if row is None or used+width+gap>available:
                row=LinearLayout(self.context)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setBaselineAligned(False)
                self.chips.addView(row,LinearLayout.LayoutParams(MATCH,WRAP))
                used=0;row_count+=1
            chip=FrameLayout(self.context)
            background=self.screen.rounded(self.screen.raised)
            background.setCornerRadius(float(height)/2)
            chip.setBackground(background)
            avatar_params=FrameLayout.LayoutParams(dp(32),dp(32),Gravity.START|Gravity.CENTER_VERTICAL)
            avatar_params.leftMargin=dp(5)
            chip.addView(self.avatar(name,32),avatar_params)
            text_params=FrameLayout.LayoutParams(MATCH,WRAP,Gravity.CENTER_VERTICAL)
            text_params.leftMargin=dp(44);text_params.rightMargin=dp(33)
            chip.addView(text,text_params)
            remove=self.screen.label("×",20,on=self.screen.raised)
            remove.setGravity(Gravity.CENTER)
            close_params=FrameLayout.LayoutParams(dp(32),MATCH,Gravity.END)
            chip.addView(remove,close_params)
            chip.setContentDescription("Убрать исполнителя "+name)
            self.click(chip,lambda name=name:self.toggle(name),self.chip_listeners)
            params=LinearLayout.LayoutParams(width,height)
            params.rightMargin=gap;params.bottomMargin=gap
            row.addView(chip,params)
            used+=width+gap
        self.chips_scroll.setLayoutParams(LinearLayout.LayoutParams(MATCH,max(dp(4),min(2,row_count)*(height+gap))))

    def render_results(self):
        self.results.removeAllViews()
        self.result_listeners.clear()
        names=artist_suggestions(self.owner,self.query,self.remote)
        selected={normalized(name) for name in self.selected}
        for name in names:
            row=FrameLayout(self.context)
            row.setMinimumHeight(dp(60))
            avatar_params=FrameLayout.LayoutParams(dp(40),dp(40),Gravity.START|Gravity.CENTER_VERTICAL)
            avatar_params.leftMargin=dp(4)
            row.addView(self.avatar(name,40),avatar_params)
            label=self.screen.label(name,16,bold=True)
            label.setIncludeFontPadding(True)
            label.setMaxLines(1)
            label.setEllipsize(TruncateAt.END)
            label.setGravity(Gravity.CENTER_VERTICAL)
            index=name.casefold().find(self.query.strip().casefold())
            if self.query.strip() and index>=0:
                try:
                    styled=jclass("android.text.SpannableString")(name)
                    styled.setSpan(jclass("android.text.style.ForegroundColorSpan")(readable_ink(self.screen.background,self.screen.accent)),index,index+len(self.query.strip()),33)
                    label.setText(styled)
                except Exception:pass
            label_params=FrameLayout.LayoutParams(MATCH,WRAP,Gravity.CENTER_VERTICAL)
            label_params.leftMargin=dp(60);label_params.rightMargin=dp(46)
            label_params.topMargin=label_params.bottomMargin=dp(8)
            row.addView(label,label_params)
            check=self.screen.label("✓" if normalized(name) in selected else "＋",22)
            check.setTextColor(readable_ink(self.screen.background,self.screen.accent))
            check.setGravity(Gravity.CENTER)
            row.addView(check,FrameLayout.LayoutParams(dp(40),dp(44),Gravity.END|Gravity.CENTER_VERTICAL))
            self.click(row,lambda name=name:self.toggle(name),self.result_listeners)
            self.results.addView(row,LinearLayout.LayoutParams(MATCH,WRAP))
        typed=self.query.strip()[:80]
        if len(normalized(typed))>=2 and normalized(typed) not in {normalized(name) for name in names}|selected:
            custom=self.screen.label("＋ Добавить «%s»"%typed,14)
            custom.setTextColor(readable_ink(self.screen.background,self.screen.accent))
            custom.setPadding(dp(6),dp(14),dp(6),dp(14))
            self.click(custom,lambda:self.toggle(typed),self.result_listeners)
            self.results.addView(custom,LinearLayout.LayoutParams(MATCH,WRAP))
        self.message.setText(self.status)

    def query_changed(self,query):
        if self.closed:return
        self.query=str(query)[:80]
        self.remote=[]
        self.serial+=1
        token=self.serial
        if self.job:self.job.cancel();self.job=None
        self.status="Ищем исполнителей…" if len(self.query.strip())>=3 else "Подсказки из коллекции и каталога"
        self.render_results()
        if len(self.query.strip())<3:return
        def search():
            if self.closed or token!=self.serial or not self.owner.valid():return
            def received(tracks,offset,error):
                if self.closed or token!=self.serial:return
                self.job=None
                self.remote=[name for track in tracks for name in artist_names(track["artist"])]
                self.status="Поиск Telegram недоступен; можно выбрать подсказку или добавить имя" if error else "Выбирай исполнителей — они появятся сверху"
                self.render_results()
            self.job=self.owner.search(self.query.strip(),"",received)
        run_on_ui_thread(search,450)

    def close(self):
        self.closed=True
        self.serial+=1
        if self.job:self.job.cancel();self.job=None


class GenreTree:
    def __init__(self,screen,draft):
        self.screen,self.draft=screen,draft
        self.expanded={parent for parent in SUBGENRES if any(key in draft.subgenres for key in draft.children(parent))}
        self.listeners=[]
        self.view=LinearLayout(screen.context)
        self.view.setOrientation(1)
        self.render()

    def click(self,view,callback):
        def clicked(v):
            callback()
            self.render()
        listener=OnClickListener(clicked)
        self.listeners.append(listener)
        view.setOnClickListener(listener)

    def expand(self,parent):
        if parent in self.expanded:self.expanded.remove(parent)
        else:self.expanded.add(parent)

    def render(self):
        self.view.removeAllViews()
        self.listeners.clear()
        for parent in GENRES:
            row=LinearLayout(self.screen.context)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(4),dp(4),dp(6),dp(4))
            row.setBackground(self.screen.rounded(self.screen.surface,18))
            state=self.draft.parent_state(parent)
            check=self.screen.label({"all":"✓","some":"−","none":"□"}[state],22,on=self.screen.surface)
            check.setTextColor(readable_ink(self.screen.surface,self.screen.accent if state!="none" else self.screen.muted,state=="none"))
            check.setGravity(Gravity.CENTER)
            check.setContentDescription("Выбрать весь жанр: "+parent)
            row.addView(check,LinearLayout.LayoutParams(dp(40),dp(52)))
            self.click(check,lambda parent=parent:self.draft.toggle_parent(parent))
            details=LinearLayout(self.screen.context)
            details.setOrientation(1)
            details.setPadding(dp(4),dp(7),0,dp(7))
            details.addView(self.screen.label(parent,16,bold=True,on=self.screen.surface))
            count=sum(key in self.draft.subgenres for key in self.draft.children(parent))
            subtitle="Все направления" if state=="all" else "Поджанров выбрано: %d"%count if count else "Уточнить поджанры"
            details.addView(self.screen.label(subtitle,12,True,on=self.screen.surface))
            row.addView(details,LinearLayout.LayoutParams(0,WRAP,1.0))
            arrow=self.screen.label("⌃" if parent in self.expanded else "⌄",24,True,on=self.screen.surface)
            arrow.setGravity(Gravity.CENTER)
            row.addView(arrow,LinearLayout.LayoutParams(dp(32),dp(50)))
            self.click(details,lambda parent=parent:self.expand(parent))
            self.click(arrow,lambda parent=parent:self.expand(parent))
            params=LinearLayout.LayoutParams(MATCH,WRAP);params.bottomMargin=dp(6)
            self.view.addView(row,params)
            if parent not in self.expanded:continue
            for child in SUBGENRES.get(parent,{}):
                selected=self.draft.child_selected(parent,child)
                item=self.screen.label(("✓  " if selected else "□  ")+child,14)
                item.setPadding(dp(44),dp(10),dp(6),dp(10))
                item.setMinHeight(dp(42))
                item.setTextColor(readable_ink(self.screen.design["selected"] if selected else self.screen.surface,self.screen.accent if selected else self.screen.foreground))
                item.setBackground(self.screen.rounded(self.screen.design["selected"] if selected else self.screen.surface,14))
                self.click(item,lambda parent=parent,child=child:self.draft.toggle_child(parent,child))
                params=LinearLayout.LayoutParams(MATCH,WRAP);params.leftMargin=dp(12);params.bottomMargin=dp(4)
                self.view.addView(item,params)


class CacheDownloads:
    """Use FileLoader's native cache and progress events; no duplicate media store."""
    def __init__(self,owner):
        self.owner=owner
        self.loader=FileLoader.getInstance(owner.account)
        self.pending=[]
        self.active={}
        self.statuses={}
        self.memo={}
        self.closed=False

    def cached_file(self,track):
        message=track.get("message")
        if message is None:return None
        try:
            document=message.getDocument()
            if document is None:return None
            expected=int(field(document,"size") or 0)
            for file in (self.loader.getPathToAttach(document,True),self.loader.getPathToMessage(message.messageOwner)):
                if file is not None and file.exists() and int(file.length())>0 and (expected<=0 or int(file.length())>=expected):return file
        except Exception:pass
        return None

    def local_file(self,track):
        cached=self.cached_file(track)
        if cached is not None:return cached
        message=track.get("message")
        if message is None:return None
        try:
            path=str(field(message.messageOwner,"attachPath") or "")
            if not path:return None
            file=jclass("java.io.File")(path)
            expected=int(field(message.getDocument(),"size") or 0)
            if file.exists() and int(file.length())>0 and (expected<=0 or int(file.length())>=expected):return file
        except Exception:pass
        return None

    def bind_local_file(self,track):
        message=track.get("message")
        if message is None:return
        try:
            file=self.local_file(track)
            # Imported playback messages are local clones of the source post.
            message.messageOwner.attachPath=str(file.getAbsolutePath()) if file is not None else ""
            try:
                # Current Telegram has both a field mediaExists and a method
                # mediaExists(). A Python assignment can resolve to the method
                # descriptor. Name the Java field explicitly instead.
                exists_field=message.getClass().getField("mediaExists")
                exists_field.setBoolean(message,file is not None)
            except Exception:
                # Let the native MessageObject recalculate when a fork exposes
                # its cache state differently. This hint must never stop audio.
                try:message.checkMediaExistance()
                except Exception:pass
        except Exception:
            self.owner.plugin.record_error("bind cached audio")
            # Cache is optional: keep the working native streaming path available.

    def state(self,track):
        key=str(track["id"])
        cached=self.memo.get(key)
        if cached and time.monotonic()-cached[0]<1.2:return cached[1]
        if self.cached_file(track) is not None:
            value=("ready",100)
        elif key in self.statuses:
            value=self.statuses[key]
            if value[0]=="ready":value=("missing",0)
        else:
            try:
                document=track["message"].getDocument()
                name=str(FileLoader.getAttachFileName(document))
                value=("loading",0) if self.loader.isLoadingFile(name) else ("missing",0)
            except Exception:
                value=("missing",0)
        self.memo[key]=(time.monotonic(),value)
        return value

    def enqueue(self,tracks):
        accepted=0
        waiting={str(t["id"]) for t in self.pending}|{str(t["id"]) for t in self.active.values()}
        for track in tracks:
            if track.get("message") is None and not track.get("source"):continue
            key=str(track["id"])
            self.owner.keep(track)
            if key not in self.owner.collection.data["cache"]:
                self.owner.collection.data["cache"].append(key)
            self.memo.pop(key,None)
            if self.cached_file(track) is not None:
                self.statuses[key]=("ready",100)
                self.bind_local_file(track)
            elif key not in waiting:
                self.pending.append(track)
                self.statuses[key]=("queued",0)
                waiting.add(key)
                accepted+=1
        self.owner.changed()
        self.pump()
        return accepted

    def pump(self):
        if self.closed or not self.owner.valid():return
        while self.pending and len(self.active)<3:
            track=self.pending.pop(0)
            key=str(track["id"])
            # Reserve a slot even while a stale Telegram file reference refreshes.
            reservation="refresh:"+key
            self.active[reservation]=track
            self.statuses[key]=("queued",0)
            def ready(fresh,reservation=reservation,key=key):
                if self.closed or not self.owner.valid() or reservation not in self.active:return
                self.active.pop(reservation,None)
                try:
                    if fresh.get("unavailable") or fresh.get("message") is None:
                        raise ValueError(str(fresh.get("unavailable") or "Аудиозапись недоступна"))
                    if str(fresh["id"])!=key:
                        self.owner.keep(fresh)
                        ids=self.owner.collection.data["cache"]
                        ids[:]=list(dict.fromkeys(str(fresh["id"]) if item==key else item for item in ids))
                        self.statuses.pop(key,None)
                        self.memo.pop(key,None)
                        key=str(fresh["id"])
                        self.owner.save()
                    document=fresh["message"].getDocument()
                    if self.cached_file(fresh) is not None:
                        self.statuses[key]=("ready",100)
                        self.memo.pop(key,None)
                        self.bind_local_file(fresh)
                        run_on_ui_thread(self.pump,1)
                        self.owner.plugin.update_screens(self.owner)
                        return
                    name=str(FileLoader.getAttachFileName(document))
                    if not name:raise ValueError("Пустое имя аудиофайла")
                    self.active[name]=fresh
                    self.statuses[key]=("loading",0)
                    self.memo.pop(key,None)
                    # cacheType=1 forces Telegram's cache directory. The original
                    # message, when available, lets its file-reference controller
                    # refresh access without trying to query a synthetic ID.
                    parent=fresh.get("source_parent") or fresh["message"]
                    self.loader.loadFile(document,parent,FileLoader.PRIORITY_NORMAL,1)
                except Exception:
                    if 'name' in locals():self.active.pop(name,None)
                    self.statuses[key]=("failed",0)
                    self.memo.pop(key,None)
                    self.owner.plugin.record_error("download cache")
                    run_on_ui_thread(self.pump,1)
                self.owner.plugin.update_screens(self.owner)
            try:self.owner.refresh_track(track,ready)
            except Exception:
                self.active.pop(reservation,None)
                self.statuses[key]=("failed",0)
                self.memo.pop(key,None)
                self.owner.plugin.record_error("prepare cache download")

    def event(self,notification_id,args):
        if self.closed or not args:return
        name=str(args[0])
        track=self.active.get(name)
        if track is None:return
        key=str(track["id"])
        if notification_id==NotificationCenter.fileLoadProgressChanged:
            try:
                progress=float(args[1])/float(args[2]) if len(args)>=3 and float(args[2])>0 else float(args[1])
                self.statuses[key]=("loading",max(0,min(99,int(progress*100))))
            except Exception:pass
            self.memo.pop(key,None)
            return
        if notification_id not in (NotificationCenter.fileLoaded,NotificationCenter.fileLoadFailed):return
        self.active.pop(name,None)
        exists=self.cached_file(track) is not None
        self.statuses[key]=("ready",100) if exists else ("failed",0)
        self.memo.pop(key,None)
        if exists:self.bind_local_file(track)
        self.owner.plugin.update_screens(self.owner)
        self.pump()

    def dispose(self):
        self.closed=True
        self.pending.clear()
        # FileLoader owns already-started downloads. Do not interrupt Telegram's
        # player or another screen using the same file when this plugin unloads.
        self.active.clear()


class ChatImport:
    """Paged, cancellable music-only import into one local playlist."""
    def __init__(self,owner,playlist_id,dialog_id,topic_id=0,limit=0):
        self.owner,self.playlist_id=owner,playlist_id
        self.dialog_id,self.topic_id=int(dialog_id),int(topic_id)
        self.limit=int(limit) if int(limit)>0 else 10000
        self.closed=False
        self.offset=0
        self.processed=0
        self.added=[]
        self.seen=set(owner.collection.data["playlists"][playlist_id]["ids"])
        self.request=None

    def start(self):
        self.owner.import_job=self
        self.load_page()

    def cancel(self):
        if self.closed:return
        if self.request:self.request.cancel()
        self.finish("Импорт остановлен")

    def finish(self,message="Импорт завершён"):
        if self.closed:return
        self.closed=True
        self.owner.import_status=message+": добавлено %d треков"%len(self.added)
        self.owner.changed()
        self.owner.save(immediate=True)

    def load_page(self):
        if self.closed:return
        if not self.owner.valid() or self.playlist_id not in self.owner.collection.data["playlists"]:
            self.cancel()
            return
        if self.processed>=self.limit:
            self.finish("Достигнут лимит %d записей"%self.limit if self.limit==10000 else "Импорт завершён")
            return
        request=TLRPC.TL_messages_search()
        request.peer=self.owner.controller.getInputPeer(self.dialog_id)
        if request.peer is None or isinstance(request.peer,TLRPC.TL_inputPeerEmpty):
            self.finish("Чат недоступен для импорта")
            return
        request.q=""
        request.filter=TLRPC.TL_inputMessagesFilterMusic()
        request.offset_id=self.offset
        request.add_offset=request.min_id=request.max_id=0
        request.limit=min(100,self.limit-self.processed)
        request.hash=0
        if self.topic_id>0:
            request.flags=int(request.flags)|2
            request.top_msg_id=self.topic_id
        def done(tracks,offset,error):
            self.request=None
            if self.closed:return
            if error:
                self.finish(error)
                return
            run_on_ui_thread(self.load_page,500)
        job=SearchJob(self.owner,done)
        self.owner.jobs.append(job)
        self.request=job
        def received(response):
            if self.closed:return
            if not self.owner.valid() or self.playlist_id not in self.owner.collection.data["playlists"]:
                job.cancel()
                self.cancel()
                return
            self.owner.controller.putUsers(response.users,False)
            self.owner.controller.putChats(response.chats,False)
            messages=java_items(response.messages)
            if not messages:
                job.cancel()
                self.request=None
                self.finish()
                return
            next_offset=min(int(raw.id) for raw in messages)
            if next_offset<=0 or (self.offset and next_offset>=self.offset):
                job.cancel()
                self.request=None
                self.finish("Telegram больше не отдаёт новые записи")
                return
            for raw in messages[:request.limit]:
                self.processed+=1
                track=self.owner.track_from_message(MessageObject(self.owner.account,raw,False,True))
                if track is None or track["id"] in self.seen:continue
                self.owner.keep(track)
                self.owner.collection.add(self.playlist_id,track["id"])
                self.seen.add(track["id"])
                self.added.append((int(raw.date),int(raw.id),track["id"]))
            # Search pages arrive newest first. Preserve the order in which songs
            # originally appeared in the chat, including when import is cancelled.
            playlist=self.owner.collection.data["playlists"].get(self.playlist_id)
            if playlist is None:
                job.cancel()
                self.cancel()
                return
            imported={item[2] for item in self.added}
            prefix=[key for key in playlist["ids"] if key not in imported]
            playlist["ids"]=prefix+[item[2] for item in sorted(self.added)]
            self.offset=next_offset
            self.owner.import_status="Импорт: просмотрено %d · добавлено %d"%(self.processed,len(self.added))
            self.owner.changed()
            job.done()
        self.owner.import_status="Ищем музыку в чате…" if not self.processed else self.owner.import_status
        self.owner.plugin.update_screens(self.owner)
        job.send(request,received)


def import_selection(context,fragment):
    """Prefer explicit selection, then the audio album, then one message."""
    messages=[]
    direct=context.get("selected_messages")
    if direct:
        try:messages.extend(list(direct))
        except Exception:pass
    arrays=field(fragment,"selectedMessagesIds")
    if arrays is not None:
        try:
            for sparse in arrays:
                for index in range(sparse.size()):messages.append(sparse.valueAt(index))
        except Exception:pass
    if not messages:
        grouped=context.get("groupedMessages")
        values=field(grouped,"messages")
        if values is not None:
            try:messages.extend(java_items(values))
            except Exception:pass
    if not messages and context.get("message") is not None:messages.append(context["message"])
    result=[]
    seen=set()
    for message in messages:
        try:
            key=(int(message.currentAccount),int(message.getDialogId()),int(message.getId()))
            if message.isMusic() and key not in seen:
                seen.add(key)
                result.append(message)
        except Exception:pass
    return result


# Motion is rendered by Telegram's native wallpaper drawable, not a Python frame loop.
def argb(value):
    value = int(value) & 0xffffffff
    return value-0x100000000 if value >= 0x80000000 else value


GRAY_WAVE_PALETTE = tuple(argb(v) for v in (0xff202020,0xff727272,0xff3b3b3b,0xff141414))




class WaveBackdrop:
    """Two native gradient layers crossfade when the current cover changes."""
    def __init__(self,screen,root):
        self.screen,self.root = screen,root
        self.layers,self.drawables = [],[]
        self.palette,self.key = None,None
        self.cache = {}
        self.last_probe = -100.0
        self.front,self.serial = 0,0
        self.closed,self.running = False,None
        self.native = None
        try:self.native = jclass("org.telegram.ui.Components.MotionBackgroundDrawable")
        except Exception:pass
        for _ in range(2):
            view = View(screen.context)
            view.setAlpha(0.0)
            view.setImportantForAccessibility(2)
            root.addView(view,FrameLayout.LayoutParams(MATCH,MATCH))
            self.layers.append(view)
            self.drawables.append(None)
        self.scrim = View(screen.context)
        shade = GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,jarray(jint)([argb(0x8f08080c),argb(0x73000000),argb(0xe808080c)]))
        self.scrim.setBackground(shade)
        self.scrim.setImportantForAccessibility(2)
        root.addView(self.scrim,FrameLayout.LayoutParams(MATCH,MATCH))
        self.set_palette(GRAY_WAVE_PALETTE,False)

    def set_palette(self,palette,animate=True):
        palette = tuple(palette)
        if palette == self.palette:return
        self.serial += 1
        serial = self.serial
        self.front = 1-self.front
        target = self.layers[self.front]
        old = self.layers[1-self.front]
        if self.drawables[self.front] is None:
            try:
                drawable = self.native(*palette,False) if self.native else None
                if drawable is not None:
                    drawable.setParentView(target)
                    try:drawable.setIndeterminateSpeedScale(0.3)
                    except Exception:pass
                else:raise ValueError("native gradient unavailable")
            except Exception:
                drawable = GradientDrawable(GradientDrawable.Orientation.TL_BR,jarray(jint)(palette))
            self.drawables[self.front] = drawable
            target.setBackground(drawable)
        else:
            drawable = self.drawables[self.front]
            try:drawable.setColors(*palette)
            except Exception:drawable.setColors(jarray(jint)(palette))
        target.animate().cancel()
        old.animate().cancel()
        old.setAlpha(1.0)
        target.setAlpha(0.0 if animate and self.palette is not None else 1.0)
        if animate and self.palette is not None:
            target.animate().alpha(1.0).setDuration(1100).start()
            old.animate().alpha(0.0).setDuration(1100).start()
            def finish():
                if not self.closed and serial == self.serial:
                    old.setAlpha(0.0)
            run_on_ui_thread(finish,1120)
        else:old.setAlpha(0.0)
        self.palette = palette
        self.running = None



    def update(self,current=None):
        if self.closed:return
        home=self.screen.page=="home"
        for view in self.layers+[self.scrim]:view.setVisibility(View.VISIBLE if home else View.GONE)
        valid=current is not None and int(current.currentAccount)==self.screen.account and current.isMusic()
        if home:
            genre=""
            if valid:
                track=self.screen.owner.owned_track(current)
                if track and self.screen.owner.is_wave_message(current):genre=self.screen.owner.wave_track_genre(track,track.get("query",""))
                else:genre=(track or {}).get("genre") or artist_genre(str(current.getMusicAuthor()),self.screen.owner.collection)
            palette=genre_palette(genre,self.screen.plugin.get_setting("design_colors",None))
            self.key=genre
            self.set_palette(palette,self.screen.visible)
        moving=bool(home and self.screen.visible and valid and not MediaController.getInstance().isMessagePaused())
        self.motion(moving)

    def motion(self,moving):
        if self.running == moving:return
        self.running = moving
        for drawable,view in zip(self.drawables,self.layers):
            if drawable is not None:
                try:drawable.setIndeterminateAnimation(bool(moving))
                except Exception:pass
                view.invalidate()

    def close(self):
        self.closed = True
        self.serial += 1
        self.motion(False)
        for drawable,view in zip(self.drawables,self.layers):
            view.animate().cancel()
            if drawable is not None:
                try:drawable.setParentView(None)
                except Exception:pass
        self.cache.clear()


