BUTTON_ID = 197031601
MATCH = -1
WRAP = -2


def dp(value):
    return AndroidUtilities.dp(float(value))


def color(key, fallback):
    try:
        return Theme.getColor(getattr(Theme, key))
    except Exception:
        return fallback


def field(obj, name):
    if obj is None:
        return None
    try:
        return getattr(obj, name)
    except Exception:
        try:
            return get_private_field(obj, name)
        except Exception:
            return None


def java_items(items):
    if items is None:
        return []
    return [items.get(i) for i in range(items.size())]


def resource(context, *names):
    for name in names:
        try:
            value = getattr(jclass("org.telegram.messenger.R$drawable"), name)
            if value:
                return int(value)
        except Exception:
            pass
        value = context.getResources().getIdentifier(name, "drawable", context.getPackageName())
        if value:
            return value
    return 0


def duration_text(seconds):
    seconds = max(0, int(seconds))
    return "%d:%02d" % (seconds // 60, seconds % 60)


def valid_username(value):
    if value is None:
        return ""
    value = str(value).strip().lstrip("@")
    return value if re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{2,31}", value) else ""


def configured_music_bot(controller):
    # New Telegram: AppGlobalConfig.StringValue. Older forks: a String field.
    config = field(controller, "config")
    for obj in (config, controller):
        value = field(obj, "musicSearchUsername")
        if value is None:
            continue
        try:
            value = value.get()
        except Exception:
            pass
        result = valid_username(value)
        if result:
            return result
    return ""


# Local recommendation rules. These genre pools are curated starting points,
# not metadata supplied by Telegram and not claims about every song by an artist.
GENRES = {
    "Русский рок": ["Кино", "Сплин", "Би-2", "ДДТ", "Земфира", "Агата Кристи", "Наутилус Помпилиус"],
    "Альтернатива": ["Anacondaz", "Noize MC", "Louna", "Animal ДжаZ", "Слот", "Порнофильмы"],
    "Русский рэп": ["Каста", "ATL", "Баста", "Oxxxymiron", "Хаски", "Guf"],
    "Рок": ["Linkin Park", "Muse", "Nirvana", "Foo Fighters", "Red Hot Chili Peppers", "Green Day"],
    "Метал": ["Metallica", "Rammstein", "System of a Down", "Slipknot", "Korn"],
    "Инди": ["Arctic Monkeys", "The Strokes", "Tame Impala", "alt-J", "The Neighbourhood"],
    "Электроника": ["Daft Punk", "The Prodigy", "Massive Attack", "Moby", "Bonobo"],
    "Поп": ["Dua Lipa", "The Weeknd", "Lady Gaga", "Zivert", "Моя Мишель"],
}


def normalized(text):
    return re.sub(r"[^\w]+", " ", str(text or "").casefold().replace("ё", "е")).strip()


def artist_names(text):
    return [part.strip() for part in re.split(r"\s+(?:feat\.?|ft\.?|featuring)\s+|[,;&]|\s+[xх×]\s+", str(text or ""), flags=re.I) if part.strip()]


def fingerprint(track):
    return normalized(track.get("artist", "")) + "|" + normalized(track.get("title", ""))


def message_token(message):
    if message is None:return None
    try:dialog=int(message.getDialogId())
    except Exception:dialog=0
    document=message.getDocument()
    return (int(message.currentAccount),dialog,int(message.getId()),str(document.id) if document is not None else "")


def same_message(first,second):
    return first is not None and second is not None and message_token(first)==message_token(second)


def owned_message_key(message):
    if message is None:return None
    try:identity=int(jclass("java.lang.System").identityHashCode(message))
    except Exception:identity=id(message)
    return (message_token(message),identity)


def copy_chat_message(message,account):
    """Preserve the actual peer/message identity used by Telegram's file loader."""
    write=SerializedData()
    read=None
    try:
        message.messageOwner.serializeToStream(write)
        read=SerializedData(write.toByteArray())
        raw=TLRPC.Message.TLdeserialize(read,read.readInt32(True),True)
        if raw is None:raise ValueError("Не удалось восстановить аудиосообщение")
        raw.dialog_id=int(message.getDialogId())
        raw.attachPath=str(field(message.messageOwner,"attachPath") or "")
        return MessageObject(int(account),raw,False,True)
    finally:
        if read is not None:read.cleanup()
        write.cleanup()


def audio_metadata(document,title="",artist="",duration=0):
    for attribute in java_items(document.attributes):
        if isinstance(attribute,TLRPC.TL_documentAttributeAudio):
            return None if bool(field(attribute,"voice")) else attribute
    # Telegram also accepts FLAC/OGG/Opus documents without embedded audio tags.
    try:music=bool(MessageObject.isMusicDocument(document))
    except Exception:music=str(field(document,"mime_type") or "").lower() in ("audio/flac","audio/ogg","audio/opus","audio/x-opus+ogg")
    if not music:return None
    if not title:
        for attribute in java_items(document.attributes):
            name=field(attribute,"file_name")
            if name:title=str(name);break
    result=TLRPC.TL_documentAttributeAudio()
    result.title=str(title or "Аудиозапись")
    result.performer=str(artist or "Неизвестный исполнитель")
    result.duration=max(0,int(duration))
    result.voice=False
    return result


class Collection:
    """JSON-safe state. No Java objects, account credentials or profile playlist APIs."""
    def __init__(self, raw=None):
        if isinstance(raw, str):
            raw = json.loads(raw)
        if raw is not None and (not isinstance(raw, dict) or raw.get("schema") != 2):
            raise ValueError("Неподдерживаемый формат коллекции")
        self.data = raw or {"schema": 2}
        defaults = {"tracks": {}, "liked": [], "playlists": {}, "seeds": [], "genres": [],
                    "scores": {}, "recent": [], "blocked": [], "hidden_short": True, "cache": [], "subgenres": []}
        for key, default in defaults.items():
            self.data.setdefault(key, default)
        for key in ("tracks", "playlists", "scores"):
            if not isinstance(self.data[key], dict):
                raise ValueError("Повреждены данные: " + key)
        for key in ("liked", "seeds", "genres", "recent", "blocked", "cache", "subgenres"):
            if not isinstance(self.data[key], list):
                raise ValueError("Повреждены данные: " + key)
        if len(self.data["tracks"]) > 10000:
            raise ValueError("Слишком большая коллекция")
        for key, item in self.data["tracks"].items():
            if not isinstance(item, dict) or not isinstance(item.get("title"), str) or not isinstance(item.get("artist"), str):
                raise ValueError("Повреждены сведения о треке")
            if len(str(item.get("document", ""))) > 200000:
                raise ValueError("Слишком большой аудиообъект")
        for playlist in self.data["playlists"].values():
            if not isinstance(playlist, dict) or not isinstance(playlist.get("name"), str) or not isinstance(playlist.get("ids"), list):
                raise ValueError("Повреждён плейлист")
        self.data["liked"] = list(dict.fromkeys(str(k) for k in self.data["liked"] if str(k) in self.data["tracks"]))
        self.data["seeds"] = clean_artists(self.data["seeds"])
        self.data["genres"] = [str(g) for g in self.data["genres"] if g in GENRES]
        catalog=subgenre_catalog()
        self.data["subgenres"] = [key for key in self.data["subgenres"] if isinstance(key,str) and key in catalog]
        self.data["cache"] = list(dict.fromkeys(str(k) for k in self.data["cache"] if str(k) in self.data["tracks"]))

    def dump(self):
        return json.dumps(self.data, ensure_ascii=False, separators=(",", ":"))

    def remember(self, track, document=""):
        key = str(track["id"])
        previous = self.data["tracks"].get(key, {})
        self.data["tracks"][key] = {"id": key, "title": str(track["title"]), "artist": str(track["artist"]),
            "duration": int(track.get("duration", 0)), "query": str(track.get("query", "")),
            "document": document or previous.get("document", ""), "fetched": float(track.get("fetched", time.time())),
            "source": track.get("source") or previous.get("source"),
            "genre": track.get("genre") or previous.get("genre","")}

    def like(self, key):
        key = str(key)
        if key not in self.data["tracks"]:
            return False
        if key in self.data["liked"]:
            self.data["liked"].remove(key)
            return False
        self.data["liked"].append(key)
        fp = fingerprint(self.data["tracks"][key])
        if fp in self.data["blocked"]:
            self.data["blocked"].remove(fp)
        return True

    def playlist(self, name):
        name = str(name).strip()[:80]
        if not name:
            raise ValueError("Введи название плейлиста")
        key = uuid.uuid4().hex[:12]
        self.data["playlists"][key] = {"name": name, "ids": []}
        return key

    def add(self, playlist_id, key):
        if str(key) not in self.data["tracks"]:
            raise ValueError("Трек недоступен")
        ids = self.data["playlists"][playlist_id]["ids"]
        if str(key) not in ids:
            ids.append(str(key))

    def adjust(self, artist, delta):
        for name in artist_names(artist):
            key = normalized(name)
            value = self.data["scores"].get(key, {"name": name, "value": 0, "updated": time.time()})
            days = max(0.0, (time.time() - float(value.get("updated", time.time()))) / 86400)
            value["value"] = max(-5.0, min(20.0, float(value.get("value", 0)) * (0.97 ** days) + delta))
            value["updated"] = time.time()
            self.data["scores"][key] = value

    def sources(self):
        weights = {}
        def put(name, score):
            name = name.strip()
            if name:
                key = normalized(name)
                old = weights.get(key, (name, 0.0))
                weights[key] = (old[0], min(30.0, old[1] + score))
        for seed in self.data["seeds"]:
            put(str(seed), 7.0)
        for key in self.data["liked"]:
            for artist in artist_names(self.data["tracks"].get(key, {}).get("artist", "")):
                put(artist, 3.0)
        for playlist in self.data["playlists"].values():
            for key in playlist["ids"]:
                for artist in artist_names(self.data["tracks"].get(str(key), {}).get("artist", "")):
                    put(artist, 1.0)
        for value in self.data["scores"].values():
            days = max(0, (time.time() - float(value.get("updated", time.time()))) / 86400)
            score = float(value.get("value", 0)) * (0.97 ** days)
            if score > 0.2:
                put(str(value.get("name", "")), score)
        familiar = set(weights)
        explicit=bool(self.data["genres"] or self.data["subgenres"])
        for genre, artists in GENRES.items():
            selected = genre in self.data["genres"]
            related = not explicit and any(normalized(a) in familiar for a in artists)
            if selected or related:
                for artist in artists:
                    put(artist, 2.0 if selected else 0.9)
        catalog=subgenre_catalog()
        for key in self.data["subgenres"]:
            for artist in catalog.get(key,[]):put(artist,3.0)
        if not explicit:
            # Expand from a recognizable artist into nearby curated directions,
            # including artists absent from the preferences themselves.
            for artists in catalog.values():
                if any(normalized(a) in familiar for a in artists):
                    for artist in artists:put(artist,1.2)
            for seed,artists in RELATED_ARTISTS.items():
                if normalized(seed) in familiar:
                    for artist in artists:put(artist,1.2)
        result = []
        for key,(name,weight) in weights.items():
            learned = self.data["scores"].get(key,{})
            negative = min(0,float(learned.get("value",0)))
            result.append((name,max(0.1,weight*(0.75**(-negative)))))
        return result

    def familiar_artists(self):
        names = set(normalized(a) for a in self.data["seeds"])
        ids = set(self.data["liked"])
        for playlist in self.data["playlists"].values():ids.update(str(k) for k in playlist["ids"])
        for key in ids:
            names.update(normalized(a) for a in artist_names(self.data["tracks"].get(key,{}).get("artist","")))
        for key,value in self.data["scores"].items():
            if float(value.get("value",0))>=1.0:names.add(key)
        return names

    def candidates(self, tracks, queued=(), last_artists=()):
        recent = {item["fp"] for item in self.data["recent"][-80:] if isinstance(item, dict) and "fp" in item}
        banned = set(self.data["blocked"]) | set(queued)
        liked = set(self.data["liked"])
        candidates, seen = [], set()
        for track in tracks:
            fp = fingerprint(track)
            if fp in banned or fp in recent or fp in seen:
                continue
            if self.data["hidden_short"] and int(track.get("duration", 0)) < 45:
                continue
            seen.add(fp)
            score = random.random() * 2.0 + (0.8 if str(track["id"]) in liked else 1.5)
            main = normalized(artist_names(track["artist"])[0] if artist_names(track["artist"]) else track["artist"])
            if main in last_artists[-2:]:
                score -= 2.0
            candidates.append((score, track))
        candidates.sort(key=lambda pair: pair[0], reverse=True)
        return [track for score, track in candidates]


def encode_document(document):
    stream = SerializedData()
    try:
        document.serializeToStream(stream)
        return str(AndroidBase64.encodeToString(stream.toByteArray(), 2))
    finally:
        stream.cleanup()


def decode_document(value):
    stream = SerializedData(AndroidBase64.decode(str(value), 2))
    try:
        return TLRPC.Document.TLdeserialize(stream, stream.readInt32(True), True)
    finally:
        stream.cleanup()


class SearchJob:
    """Each UI search / Wave fill gets an independent cancellable request chain."""
    def __init__(self, account, callback):
        self.owner = account
        self.callback = callback
        self.closed = False
        self.serial = 0
        self.request_id = 0
        self.delegate = None

    def cancel(self):
        self.closed = True
        self.serial += 1
        if self.request_id:
            try:
                self.owner.connection.cancelRequest(self.request_id, True)
            except Exception:
                pass
        self.request_id = 0
        self.delegate = None
        if self in self.owner.jobs:
            self.owner.jobs.remove(self)

    def done(self, tracks=None, offset="", error=""):
        if self.closed:
            return
        callback = self.callback
        self.cancel()
        callback(tracks or [], offset, error)

    def send(self, request, success):
        if self.closed or not self.owner.valid():
            self.cancel()
            return
        self.serial += 1
        serial = self.serial
        def response_received(response, error):
            def deliver():
                if self.closed or serial != self.serial or not self.owner.valid():
                    return
                self.request_id = 0
                self.delegate = None
                if error is not None:
                    self.done(error="Telegram: " + str(error.text))
                    return
                try:
                    if response is None:
                        raise ValueError("Пустой ответ Telegram")
                    success(response)
                except Exception:
                    self.owner.plugin.record_error("search response")
                    self.done(error="Не удалось обработать ответ Telegram")
            run_on_ui_thread(deliver)
        try:
            self.delegate = RequestCallback(response_received)
            self.request_id = int(self.owner.connection.sendRequest(request, self.delegate))
        except Exception:
            self.owner.plugin.record_error("search send")
            self.done(error="Не удалось выполнить запрос")
            return
        def timeout():
            if not self.closed and serial == self.serial and self.request_id:
                self.done(error="Запрос Telegram не ответил за 25 секунд")
        run_on_ui_thread(timeout, 25000)

    def start(self, query, offset):
        self.query, self.offset = query, offset
        username = valid_username(self.owner.plugin.get_setting("bot_username", "")) or configured_music_bot(self.owner.controller)
        if username:
            self.resolve(username)
        else:
            request = TLRPC.TL_help_getAppConfig()
            request.hash = 0
            def config_received(response):
                for entry in java_items(field(field(response, "config"), "value")):
                    if str(field(entry, "key")) == "music_search_username":
                        username = valid_username(field(field(entry, "value"), "value"))
                        if username:
                            self.resolve(username)
                            return
                self.done(error="В конфигурации Telegram нет музыкального поиска")
            self.send(request, config_received)

    def resolve(self, username):
        if self.owner.bot is not None and self.owner.bot_username == username:
            self.fetch()
            return
        request = TLRPC.TL_contacts_resolveUsername()
        request.username = username
        def resolved(response):
            self.owner.controller.putUsers(response.users, False)
            self.owner.controller.putChats(response.chats, False)
            peer_id = int(field(field(response, "peer"), "user_id") or 0)
            bot = next((user for user in java_items(response.users) if int(user.id) == peer_id and user.bot), None)
            if bot is None:
                self.done(error="Музыкальный бот недоступен: @" + username)
                return
            self.owner.bot, self.owner.bot_username = bot, username
            self.fetch()
        self.send(request, resolved)

    def fetch(self):
        request = TLRPC.TL_messages_getInlineBotResults()
        request.bot = self.owner.controller.getInputUser(self.owner.bot)
        request.peer = TLRPC.TL_inputPeerSelf()
        request.query, request.offset = self.query, self.offset
        def results_received(response):
            self.owner.controller.putUsers(response.users, False)
            tracks = []
            for result in java_items(response.results):
                document = field(result, "document")
                if document is None:
                    continue
                audio = audio_metadata(document,str(field(result,"title") or ""))
                if audio is None or bool(field(audio, "voice")):
                    continue
                tracks.append(self.owner.make_track(document, audio, self.query, field(result, "title")))
            self.done(tracks, str(response.next_offset or ""))
        self.send(request, results_received)


class MusicAccount:
    def __init__(self, plugin, account):
        self.plugin, self.account = plugin, int(account)
        self.user_id = int(UserConfig.getInstance(self.account).getClientUserId())
        self.key = "collection_" + str(self.user_id)
        try:
            self.collection = Collection(plugin.get_setting(self.key, None))
        except Exception:
            plugin.record_error("read collection")
            self.collection = Collection()
            # Retain the original setting until the user explicitly makes changes.
        self.controller = MessagesController.getInstance(self.account)
        self.connection = ConnectionsManager.getInstance(self.account)
        self.bot, self.bot_username = None, ""
        self.jobs = []
        self.runtime = {}
        self.owned = {}
        self.wave_active = False
        self.wave_seed = None
        self.wave_collection = None
        self.seed_starting = False
        self.wave_queue = []
        self.wave_pool = []
        self.wave_position = -1
        self.wave_job = None
        self.wave_serial = 0
        self.wave_busy = False
        self.wave_status = "Нажми, чтобы включить свою музыку"
        self.native_transitions,self.python_transitions = 0,0
        self.last_transition = "ещё не было"
        self.wave_rebuilding = False
        self.wave_excluded = []
        self.last_shake = -100.0
        self.source_history = []
        self.source_turn = 0
        self.offsets = {}
        self.attempts = 0
        self.last_source = ""
        self.failures = 0
        self.session = None
        self.dirty = False
        self.save_serial = 0
        self.transitioning = False
        self.play_serial = 0
        self.local_queue = []
        self.waiting_next = False
        self.baseline_message = None
        self.installing = False
        self.downloads = CacheDownloads(self)
        self.import_job = None
        self.import_status = ""
        self.warming=set()
        self.warm_failed={}

    def valid(self):
        return self.plugin.active and self.user_id > 0 and int(UserConfig.getInstance(self.account).getClientUserId()) == self.user_id

    def save(self, immediate=False):
        self.dirty = True
        self.save_serial += 1
        serial = self.save_serial
        def commit():
            if serial != self.save_serial or not self.dirty:
                return
            try:
                self.prune()
                self.plugin.set_setting(self.key, self.collection.dump())
                self.dirty = False
            except Exception:
                self.plugin.record_error("save collection")
        if immediate:
            commit()
        else:
            run_on_ui_thread(commit, 600)

    def prune(self):
        tracks = self.collection.data["tracks"]
        keep = set(self.collection.data["liked"])
        keep.update(self.collection.data["cache"])
        for playlist in self.collection.data["playlists"].values():
            keep.update(playlist["ids"])
        keep.update(item.get("id") for item in self.collection.data["recent"][-120:])
        spare = sorted((k for k in tracks if k not in keep), key=lambda k:tracks[k].get("fetched", 0), reverse=True)
        for key in spare[200:]:
            tracks.pop(key, None)

    def changed(self):
        self.save()
        self.plugin.update_screens(self)

    def search(self, query, offset, callback):
        job = SearchJob(self, callback)
        self.jobs.append(job)
        # A deferred start lets callers retain the job before any synchronous error.
        run_on_ui_thread(lambda:job.start(str(query)[:200], str(offset)), 1)
        return job

    def make_track(self, document, audio, query="", fallback=None):
        message = TLRPC.TL_message()
        message.out = True
        message.id = self.plugin.next_message_id()
        message.peer_id, message.from_id = TLRPC.TL_peerUser(), TLRPC.TL_peerUser()
        message.peer_id.user_id = message.from_id.user_id = self.user_id
        message.date, message.message, message.attachPath = int(time.time()), "", ""
        message.media = TLRPC.TL_messageMediaDocument()
        message.media.flags = int(message.media.flags) | 3
        message.media.document = document
        message.flags = int(message.flags) | int(TLRPC.MESSAGE_FLAG_HAS_MEDIA) | int(TLRPC.MESSAGE_FLAG_HAS_FROM_ID)
        track = {"id":str(document.id), "message":MessageObject(self.account, message, False, True),
            "title":str(audio.title or fallback or "Без названия"), "artist":str(audio.performer or "Неизвестный исполнитель"),
            "duration":max(0, int(audio.duration)), "query":str(query), "fetched":time.time()}
        self.runtime[track["id"]] = track
        self.owned[owned_message_key(track["message"])] = track
        # Bound transient lookup maps without evicting the native Wave queue.
        if len(self.owned) > 1200:
            keep = {owned_message_key(t.get("message")) for t in self.wave_queue+self.local_queue}
            keep.add(owned_message_key(MediaController.getInstance().getPlayingMessageObject()))
            for key in list(self.owned)[:300]:
                if key not in keep:
                    self.owned.pop(key, None)
        if len(self.runtime) > 1200:
            for key in list(self.runtime)[:200]:
                self.runtime.pop(key, None)
        return track

    def owned_track(self, message):
        if message is None or int(message.currentAccount) != self.account:
            return None
        track = self.owned.get(owned_message_key(message))
        document = message.getDocument()
        return track if track and document is not None and str(document.id)==str(track["id"]) else None

    def playing_track(self):
        """Resolve the displayed song only when the user opens its actions."""
        message=MediaController.getInstance().getPlayingMessageObject()
        if not self.valid() or message is None or int(message.currentAccount)!=self.account or not message.isMusic():return None
        owned=self.owned_track(message)
        if owned:return owned
        imported=self.track_from_message(message)
        if imported:return imported
        # Telegram's public music search also creates local, negative-ID posts.
        # Do not turn a rejected private/secret/ephemeral message into such a post.
        if int(message.getId())>=0 or int(message.getDialogId())!=self.user_id:return None
        document=message.getDocument()
        if document is None or field(document,"key") is not None:return None
        if int(field(field(message.messageOwner,"media"),"ttl_seconds") or 0)>0:return None
        audio=audio_metadata(document)
        if audio is None:return None
        track=self.make_track(document,audio)
        track["genre"]=artist_genre(track["artist"],self.collection)
        track["message"].messageOwner.attachPath=str(field(message.messageOwner,"attachPath") or "")
        return track

    def keep(self, track):
        if track.get("message") is None:
            self.collection.remember(track)
            return
        try:
            encoded = encode_document(track["message"].getDocument())
        except Exception:
            self.plugin.record_error("serialize document")
            encoded = ""
        self.collection.remember(track, encoded)

    def materialize(self, key):
        key = str(key)
        if key in self.runtime:
            return self.runtime[key]
        stored = self.collection.data["tracks"].get(key)
        if not stored:
            return None
        try:
            document = decode_document(stored["document"])
            audio = audio_metadata(document,stored["title"],stored["artist"],stored.get("duration",0))
            if audio is None:raise ValueError("Документ не является музыкой")
            track = self.make_track(document, audio, stored.get("query", ""), stored["title"])
            track["fetched"] = float(stored.get("fetched", 0))
            track["source"] = stored.get("source")
            track["genre"] = stored.get("genre","")
            return track
        except Exception:
            if stored.get("source"):
                track=dict(stored)
                track["message"]=None
                self.runtime[key]=track
                return track
            return None

    def toggle_like(self, track):
        self.keep(track)
        liked = self.collection.like(track["id"])
        self.changed()
        return liked

    def add_to_playlist(self, playlist_id, track):
        self.keep(track)
        self.collection.add(playlist_id, track["id"])
        self.changed()

    def block(self, track):
        fp = fingerprint(track)
        if fp not in self.collection.data["blocked"]:
            self.collection.data["blocked"].append(fp)
        if self.wave_active:
            self.wave_queue = [t for i,t in enumerate(self.wave_queue) if i<=self.wave_position or fingerprint(t)!=fp]
        self.changed()

    def start_wave(self):
        if not self.valid():
            return
        if not self.plugin.wave_available:
            self.wave_status = "Обработчик очереди недоступен в этой сборке. Открой диагностику."
            self.plugin.update_screens(self)
            return
        if not self.collection.sources():
            self.wave_status = "Выбери исполнителей или жанры для начала"
            self.plugin.update_screens(self)
            return
        self.stop_wave()
        self.wave_active = True
        self.wave_queue, self.wave_position = [], -1
        self.wave_pool = []
        self.wave_excluded = []
        self.source_history,self.source_turn = [],0
        self.waiting_next = False
        self.baseline_message = MediaController.getInstance().getPlayingMessageObject()
        self.offsets, self.attempts, self.failures = {}, 0, 0
        self.wave_status = "Собираем твою волну…"
        self.fill_wave()

    def wave_sources(self):
        seed=getattr(self,"wave_seed",None)
        grouped=getattr(self,"wave_collection",None)
        if grouped:
            return [(name,weight*max(0.55,min(1.2,1+float(self.collection.data["scores"].get(normalized(name),{}).get("value",0))*0.04))) for name,weight in grouped["profile"]["sources"]]
        return track_wave_sources(seed["track"],seed["direction"],self.collection) if seed else self.collection.sources()

    def wave_heading(self):
        if self.wave_seed:return "Волна по треку"
        if self.wave_collection:return "Волна любимого" if self.wave_collection["kind"]=="liked" else "Волна плейлиста"
        return "Моя волна"

    def wave_caption(self):
        if self.wave_seed:return self.wave_seed["track"]["title"]+" — "+self.wave_seed["track"]["artist"]
        if self.wave_collection:return self.wave_collection["name"]+" · треков: %d"%self.wave_collection["profile"]["count"]
        return "Знакомое и новые открытия"

    def wave_track_genre(self,track,query=""):
        if self.wave_seed:return self.wave_seed["direction"].split("/",1)[0]
        if self.wave_collection:
            genres=self.wave_collection["profile"]["genres"]
            for name in [query]+artist_names(track.get("artist","")):
                if normalized(name) in genres:return genres[normalized(name)]
            return track_direction(track).split("/",1)[0]
        return artist_genre(track["artist"],self.collection,query)

    def restart_wave(self):
        if self.wave_seed:return self.start_track_wave(self.wave_seed["track"],self.wave_seed["direction"])
        if self.wave_collection:
            context=self.wave_collection
            return self.start_collection_wave(context["kind"],context.get("playlist_id"),context.get("fallback",""))
        self.start_wave()
        return self.wave_active

    def start_collection_wave(self,kind,playlist_id=None,fallback=""):
        if not self.valid() or kind not in ("liked","playlist"):return False
        if not self.plugin.wave_available:
            self.plugin.music_notice(self,"Обработчик очереди недоступен. Открой диагностику.")
            return False
        if kind=="liked":ids=self.collection.data["liked"];name="Любимое"
        else:
            playlist=self.collection.data["playlists"].get(playlist_id)
            if playlist is None:
                self.plugin.music_notice(self,"Этот плейлист уже удалён")
                return False
            ids=playlist["ids"];name=playlist["name"]
        profile=collection_wave_profile(ids,self.collection,fallback)
        if not profile["count"]:
            self.plugin.music_notice(self,"Добавь песни в эту коллекцию, чтобы запустить волну")
            return False
        if not profile["sources"]:
            self.plugin.music_notice(self,"Не удалось определить исполнителей. Выбери направление волны.")
            return False
        self.stop_wave()
        self.wave_collection={"kind":kind,"playlist_id":playlist_id,"name":name,"fallback":fallback,"profile":profile}
        self.wave_active=True
        self.wave_queue,self.wave_pool,self.wave_position=[],[],-1
        self.wave_excluded=[]
        self.source_history,self.source_turn=[],0
        self.offsets,self.attempts,self.failures={},0,0
        self.baseline_message=MediaController.getInstance().getPlayingMessageObject()
        current=self.owned_track(self.baseline_message)
        if current and str(current["id"]) in profile["ids"]:
            current["genre"]=self.wave_track_genre(current)
            self.wave_queue,self.wave_position=[current],0
            self.seed_starting=True
            try:started=self.install_playlist(self.wave_queue,current)
            finally:self.seed_starting=False
            if not started:
                self.wave_active=False
                self.wave_status="Плеер не смог продолжить текущую песню"
                self.plugin.update_screens(self)
                return False
            self.local_queue=[]
            self.sync_wave_playlist()
        self.wave_status=self.wave_ready_text()
        self.plugin.update_screens(self)
        self.fill_wave()
        return self.wave_active

    def wave_ready_text(self):
        seed=getattr(self,"wave_seed",None)
        grouped=getattr(self,"wave_collection",None)
        if grouped:return "Подбор по всей коллекции · треков: %d · исполнителей: %d"%(grouped["profile"]["count"],len(grouped["profile"]["familiar"]))
        return "По треку · "+seed["direction"].replace("/"," · ") if seed else "Твоя волна · подбираем по твоим интересам"

    def wave_exclusions(self):
        excluded=set(self.wave_excluded)
        seed=getattr(self,"wave_seed",None)
        if seed:excluded.add(fingerprint(seed["track"]))
        grouped=getattr(self,"wave_collection",None)
        if grouped:excluded.update(grouped["profile"]["excluded"])
        return excluded

    def start_track_wave(self,track,direction):
        if not self.valid():return False
        if track.get("message") is not None and int(track["message"].currentAccount)!=self.account:return False
        if not self.plugin.wave_available:
            self.plugin.music_notice(self,"Обработчик очереди недоступен. Открой диагностику.")
            return False
        if direction not in GENRES and direction not in subgenre_catalog():return False
        self.stop_wave()
        self.wave_seed={"track":dict(track),"direction":direction}
        self.wave_active,self.seed_starting=True,True
        self.wave_queue,self.wave_pool,self.wave_position=[],[],-1
        self.wave_excluded=[fingerprint(track)]
        self.source_history,self.source_turn=[],0
        self.offsets,self.attempts,self.failures={},0,0
        self.baseline_message=MediaController.getInstance().getPlayingMessageObject()
        self.wave_status="Подготавливаем исходную песню…"
        serial=self.wave_serial
        self.plugin.update_screens(self)
        def ready(fresh):
            if not self.valid() or serial!=self.wave_serial or not self.wave_active or not self.seed_starting:return
            if fresh.get("unavailable") or fresh.get("message") is None:
                self.seed_starting,self.wave_active=False,False
                self.wave_status=str(fresh.get("unavailable") or "Исходная песня недоступна")
                self.plugin.music_notice(self,self.wave_status)
                self.plugin.update_screens(self)
                return
            media=MediaController.getInstance()
            playing=media.getPlayingMessageObject()
            current=self.owned_track(playing)
            # Starting a wave around the currently playing song keeps its seek
            # position and its real source-message context.
            if current and str(current["id"])==str(fresh["id"]):fresh=current
            elif playing is not None and int(playing.currentAccount)==self.account and playing.isMusic() and str(playing.getDocument().id)==str(fresh["id"]):
                for name in ("audioProgress","audioProgressSec","audioProgressMs"):
                    try:setattr(fresh["message"],name,getattr(playing,name))
                    except Exception:pass
                # Native playMessage compares dialog+message IDs and would keep
                # the original chat object. Release it before playing our clone.
                if same_message(playing,fresh["message"]):media.cleanupPlayer(False,False)
            fresh["genre"]=direction.split("/",1)[0]
            self.wave_seed["track"]=dict(fresh)
            self.wave_excluded=list(dict.fromkeys(self.wave_excluded+[fingerprint(fresh)]))
            self.wave_queue,self.wave_position=[fresh],0
            started=self.install_playlist(self.wave_queue,fresh)
            self.seed_starting=False
            if not started or not same_message(media.getPlayingMessageObject(),fresh["message"]):
                self.wave_active=False
                self.wave_status="Плеер не смог запустить исходную песню"
                self.plugin.update_screens(self)
                return
            self.local_queue=[]
            self.sync_wave_playlist()
            self.wave_status=self.wave_ready_text()
            self.plugin.update_screens(self)
            self.fill_wave()
        try:self.refresh_track(track,ready)
        except Exception:
            if serial==self.wave_serial:
                self.seed_starting,self.wave_active=False,False
                self.wave_status="Не удалось подготовить исходную песню. Открой диагностику."
                self.plugin.record_error("start track wave")
                self.plugin.update_screens(self)
        return self.wave_active

    def stop_wave(self,keep_seed=False):
        self.wave_active = False
        self.seed_starting = False
        if not keep_seed:self.wave_seed,self.wave_collection=None,None
        self.wave_rebuilding = False
        self.play_serial += 1
        self.warming.clear()
        self.warm_failed.clear()
        self.waiting_next = False
        self.wave_serial += 1
        self.wave_busy = False
        if self.wave_job is not None:
            self.wave_job.cancel()
            self.wave_job = None
        self.plugin.update_screens(self)

    def shake_wave(self):
        """Replace upcoming music only after a fresh batch has actually arrived."""
        if not self.valid():return False
        now = time.monotonic()
        if self.seed_starting or self.wave_rebuilding or now-self.last_shake < 3.0:return False
        self.last_shake = now
        if not self.wave_active:
            self.restart_wave()
            return self.wave_active
        self.wave_serial += 1
        if self.wave_job:self.wave_job.cancel()
        self.wave_job, self.wave_busy = None, False
        old = [fingerprint(t) for t in self.wave_queue+self.wave_pool]
        self.wave_excluded = list(dict.fromkeys(self.wave_excluded+old))[-240:]
        self.wave_rebuilding = True
        self.offsets, self.attempts, self.failures = {}, 0, 0
        self.wave_status = "Встряхиваем волну · ищем новые песни…"
        self.plugin.update_screens(self)
        self.fill_wave()
        return True

    def settings_changed(self):
        self.changed()
        if not self.wave_active:
            return
        if self.seed_starting:return
        current = self.owned_track(MediaController.getInstance().getPlayingMessageObject())
        if current:current["genre"]=self.wave_track_genre(current)
        self.wave_serial += 1
        if self.wave_job:
            self.wave_job.cancel()
            self.wave_job = None
        self.wave_busy = False
        self.wave_rebuilding = False
        self.wave_excluded = [fingerprint(self.wave_seed["track"])] if self.wave_seed else []
        self.wave_queue = [current] if current else []
        self.wave_pool = []
        self.wave_position = 0 if current else -1
        self.offsets, self.attempts, self.failures = {}, 0, 0
        self.fill_wave()

    def fill_wave(self):
        if not self.wave_active or not self.valid() or self.wave_busy or self.failures or getattr(self,"seed_starting",False):
            return
        remaining = 0 if self.wave_rebuilding else len(self.wave_queue) - self.wave_position - 1
        if remaining >= 18 or self.attempts >= 12:
            if remaining == 0:
                self.wave_status = "Новых песен пока нет · прежняя очередь сохранена" if self.wave_rebuilding else "Пока нет новых треков. Встряхни волну или измени направление." if self.wave_seed else "Пока нет новых треков. Добавь исполнителей или встряхни волну."
            self.wave_rebuilding = False
            self.plugin.update_screens(self)
            return
        sources = self.wave_sources()
        if not sources:
            self.wave_status = "Нужны любимые треки, исполнители или жанры"
            self.plugin.update_screens(self)
            return
        query = self.choose_wave_source(sources)
        self.last_source = query
        offset = self.offsets.get(query, "")
        self.attempts += 1
        self.wave_busy = True
        serial = self.wave_serial
        def filled(tracks, next_offset, error):
            if serial != self.wave_serial or not self.wave_active:
                return
            self.wave_job, self.wave_busy = None, False
            if error:
                self.failures += 1
                self.wave_rebuilding = False
                self.wave_status = error + ". Нажми «Продолжить волну» для повтора."
                self.plugin.update_screens(self)
                # Respect Telegram rate limits; do not retry failed calls in a loop.
                return
            self.failures = 0
            self.offsets[query] = next_offset if next_offset != offset else ""
            tracks = [track for track in tracks if normalized(query) in normalized(track["artist"])]
            if self.wave_seed or self.wave_collection:
                tracks=[track for track in tracks if normalized(query) in {normalized(a) for a in artist_names(track["artist"])}]
            for track in tracks:track["genre"]=self.wave_track_genre(track,query)
            queued = {fingerprint(track) for track in self.wave_queue}
            last = [normalized(artist_names(track["artist"])[0]) for track in self.wave_queue[-2:] if artist_names(track["artist"])]
            pooled = {fingerprint(t) for t in self.wave_pool}
            candidates = self.collection.candidates(tracks, queued | pooled | self.wave_exclusions(), last)
            rebuilt = self.wave_rebuilding and bool(candidates)
            if rebuilt:
                current_message = MediaController.getInstance().getPlayingMessageObject()
                current = self.owned_track(current_message) if self.is_wave_message(current_message) else None
                self.wave_queue = [current] if current else []
                self.wave_position = 0 if current else -1
                self.wave_pool = []
                self.wave_rebuilding = False
            self.wave_pool.extend(candidates[:25])
            self.wave_pool = self.wave_pool[-240:]
            added = self.drain_pool()
            if added:
                self.attempts = 0
                self.wave_status = self.wave_ready_text()
            if self.wave_position == -1 and self.wave_queue:
                self.play_wave_index(0)
            elif self.waiting_next and self.wave_position+1 < len(self.wave_queue):
                self.waiting_next = False
                self.play_wave_index(self.wave_position+1)
            elif rebuilt or added:
                # Update the native queue without calling playMessage: preserve
                # both the current seek position and the paused state.
                self.sync_wave_playlist()
            self.plugin.update_screens(self)
            if self.wave_rebuilding and self.attempts>=12:
                self.wave_rebuilding = False
                self.wave_status = "Новых песен пока нет · прежняя очередь сохранена"
                self.plugin.update_screens(self)
            if (self.wave_rebuilding or len(self.wave_queue) - self.wave_position - 1 < 18) and self.attempts < 12:
                # A finite batch, sequential requests, with pacing between queries.
                run_on_ui_thread(lambda:self.fill_wave() if serial == self.wave_serial else None, 1600)
        self.wave_job = self.search(query, offset, filled)

    def drain_pool(self):
        queued = {fingerprint(t) for t in self.wave_queue} | self.wave_exclusions()
        self.wave_pool = self.collection.candidates(self.wave_pool,queued)
        source_count = len(self.wave_sources())
        gap = min(4,max(0,source_count-1))
        # If several sources returned no fresh audio, relax to available artists
        # rather than leaving the player without a next song.
        if self.attempts>=8:
            available = {normalized(artist_names(t["artist"])[0]) for t in self.wave_pool+self.wave_queue[-4:] if artist_names(t["artist"])}
            gap = min(gap,max(0,len(available)-1))
        added=[]
        while self.wave_pool and len(self.wave_queue)-self.wave_position-1<20:
            last={normalized(a) for t in (self.wave_queue[-gap:] if gap else []) for a in artist_names(t["artist"])}
            counts={}
            for t in self.wave_queue[self.wave_position+1:]:
                main=normalized(artist_names(t["artist"])[0] if artist_names(t["artist"]) else t["artist"])
                counts[main]=counts.get(main,0)+1
            cap = max(4,(20+min(5,source_count)-1)//max(1,min(5,source_count)))
            index=None
            for i,track in enumerate(self.wave_pool):
                main=normalized(artist_names(track["artist"])[0] if artist_names(track["artist"]) else track["artist"])
                performers={normalized(a) for a in artist_names(track["artist"])}
                if not (performers & last) and counts.get(main,0)<cap:
                    index=i
                    break
            if index is None:break
            track=self.wave_pool.pop(index)
            self.wave_queue.append(track)
            added.append(track)
        return added

    def choose_wave_source(self,sources):
        seed=getattr(self,"wave_seed",None)
        grouped=getattr(self,"wave_collection",None)
        familiar = grouped["profile"]["familiar"] if grouped else {normalized(a) for a in artist_names(seed["track"]["artist"])} if seed else self.collection.familiar_artists()
        known = [(name,w) for name,w in sources if normalized(name) in familiar]
        discover = [(name,w) for name,w in sources if normalized(name) not in familiar]
        # Roughly two discovery searches for each familiar-artist search. This is
        # a search policy, not a promise of an exact percentage of final songs.
        self.source_turn += 1
        pool = discover if discover and (not known or self.source_turn%3!=0) else known or discover
        recent = set(self.source_history[-min(6,max(0,len(pool)-1)):]) if len(pool)>1 else set()
        alternatives = [(name,w) for name,w in pool if normalized(name) not in recent]
        pool = alternatives or pool
        counts = {}
        for track in self.wave_queue[max(0,self.wave_position):]:
            for artist in artist_names(track["artist"]):
                key=normalized(artist);counts[key]=counts.get(key,0)+1
        weights = [w/(1+counts.get(normalized(name),0))**2 for name,w in pool]
        query = random.choices([name for name,w in pool],weights=weights,k=1)[0]
        self.source_history = (self.source_history+[normalized(query)])[-16:]
        return query

    def sync_wave_playlist(self):
        media = MediaController.getInstance()
        current = media.getPlayingMessageObject()
        if not self.is_wave_message(current):return
        ordered = list(self.wave_queue) if bool(SharedConfig.playOrderReversed) else list(reversed(self.wave_queue))
        try:
            index_field = media.getClass().getDeclaredField("currentPlaylistNum")
            index_field.setAccessible(True)
            native = media.getPlaylist()
            shuffled = None
            if SharedConfig.shuffleMusic:
                sf = media.getClass().getDeclaredField("shuffledPlaylist")
                sf.setAccessible(True)
                shuffled = sf.get(media)
            native.clear()
            for track in ordered:native.add(track["message"])
            active = native
            if shuffled is not None:
                shuffled.clear()
                for track in ordered:shuffled.add(track["message"])
                active = shuffled
            index_field.setInt(media,active.indexOf(current))
            mapping = field(media,"playlistMap")
            if mapping is not None:
                mapping.clear()
                for track in ordered:mapping.put(int(track["message"].getId()),track["message"])
        except Exception:
            self.plugin.record_error("refresh wave queue")

    def is_wave_message(self, message):
        track = self.owned_track(message)
        return bool(self.wave_active and track and any(t["message"].getId() == message.getId() for t in self.wave_queue))

    def allow_native_wave_end(self,current):
        """Keep Telegram's synchronous end-of-track path for a prepared next song.

        Do not cancel the native transition and post another Python/UI task at
        this boundary: the app can be backgrounded and the display asleep.
        Read and validate everything before handing off; stale native entries
        (e.g. after blocking a song) must never bypass the plugin queue.
        """
        if not self.is_wave_message(current):return False
        media=MediaController.getInstance()
        try:
            if field(media,"currentSavedMusicList") is not None:return False
            native=field(media,"shuffledPlaylist") if SharedConfig.shuffleMusic else media.getPlaylist()
            position=int(field(media,"currentPlaylistNum"))
            if native is None or position<0 or position>=native.size():return False
            item=native.get(position)
            if int(item.currentAccount)!=self.account or int(item.getId())!=int(current.getId()):return False
            if int(SharedConfig.repeatMode)!=2:
                step=1 if bool(SharedConfig.playOrderReversed) else -1
                next_index=position+step
                if next_index<0 or next_index>=native.size():return False
                target=self.owned_track(native.get(next_index))
                current_position=next((i for i,t in enumerate(self.wave_queue) if int(t["message"].getId())==int(current.getId())),-1)
                if target is None or current_position<0:return False
                upcoming=self.wave_queue[current_position+1:]
                if not upcoming:return False
                if SharedConfig.shuffleMusic:
                    if not any(int(t["message"].getId())==int(target["message"].getId()) for t in upcoming):return False
                elif int(upcoming[0]["message"].getId())!=int(target["message"].getId()):return False
                self.downloads.bind_local_file(target)
            # setPlaylist(loadMusic=False) sets this true by default. Keep native
            # repeat-one/end-of-list semantics instead of implicitly looping.
            loop=media.getClass().getDeclaredField("forceLoopCurrentPlaylist")
            loop.setAccessible(True)
            loop.setBoolean(media,False)
        except Exception:
            return False
        self.native_transitions+=1
        self.last_transition="штатный плеер Telegram"
        return True

    def play_wave_index(self, index):
        if not self.wave_active or not self.wave_queue or not self.valid():
            return
        index = max(0, min(index, len(self.wave_queue)-1))
        self.wave_position = index
        track = self.wave_queue[index]
        self.install_playlist(self.wave_queue, track)
        self.local_queue=[]
        if self.wave_position > 25:
            self.wave_queue = self.wave_queue[self.wave_position-15:]
            self.wave_position = 15
        self.plugin.update_screens(self)
        if len(self.wave_queue) - self.wave_position - 1 < 8:
            self.attempts = 0
            self.fill_wave()

    def advance(self, previous=False, by_stop=False, expected_mid=None):
        if self.transitioning or not self.wave_active:
            return
        current = MediaController.getInstance().getPlayingMessageObject()
        if not self.is_wave_message(current):
            return
        if expected_mid is not None and int(current.getId())!=expected_mid:
            return
        self.transitioning = True
        try:
            self.observe(current)
            if not previous and not by_stop and self.session and self.session["listened"] < 12:
                self.collection.adjust(self.session["track"]["artist"], -0.2)
                self.save()
            pos = next((i for i,t in enumerate(self.wave_queue) if int(t["message"].getId()) == int(current.getId())),self.wave_position)
            repeat_one = by_stop and int(SharedConfig.repeatMode) == 2
            if repeat_one or (previous and int(current.audioProgressSec) > 10):
                MediaController.getInstance().seekToProgress(current, 0.0)
                MediaController.getInstance().playMessage(current)
                self.session = None
                return
            index = max(0,pos-1) if previous else pos+1
            if not previous and SharedConfig.shuffleMusic and pos+1 < len(self.wave_queue):
                index = random.randrange(pos+1,len(self.wave_queue))
            if index >= len(self.wave_queue):
                self.wave_position = pos
                self.wave_status = "Ищем следующие песни…"
                self.attempts = 0
                self.waiting_next = True
                if not by_stop:
                    MediaController.getInstance().pauseMessage(current)
                self.fill_wave()
            else:
                self.play_wave_index(index)
        finally:
            self.transitioning = False

    def install_playlist(self, tracks, target):
        playlist = ArrayList()
        # Telegram's default next direction is backwards through its playlist.
        ordered = [t for t in (list(tracks) if bool(SharedConfig.playOrderReversed) else list(reversed(tracks))) if t.get("message") is not None]
        for track in ordered:
            self.downloads.bind_local_file(track)
            playlist.add(track["message"])
        media = MediaController.getInstance()
        self.installing = True
        try:
            ok = media.setPlaylist(playlist, target["message"], 0, False, None)
        finally:
            self.installing = False
        # Keep the explicit order for ordinary local playlists too. setPlaylist
        # sorts synthetic IDs; reorder the existing list without restarting audio.
        if not bool(SharedConfig.shuffleMusic):
            native = media.getPlaylist()
            # Resolve before mutating: if a fork changed this field, preserve its
            # original playlist order rather than leave an invalid current index.
            try:
                index_field = media.getClass().getDeclaredField("currentPlaylistNum")
                index_field.setAccessible(True)
                native.clear()
                for track in ordered:
                    native.add(track["message"])
                index_field.setInt(media,native.indexOf(target["message"]))
            except Exception:
                self.plugin.record_error("playlist order")
        if not self.wave_active:
            self.local_queue = list(tracks)
            try:
                loop_field=media.getClass().getDeclaredField("forceLoopCurrentPlaylist")
                loop_field.setAccessible(True)
                loop_field.setBoolean(media,False)
            except Exception:
                pass
        if not ok:
            self.wave_status = "Плеер не смог запустить трек"
        self.observe(media.getPlayingMessageObject())
        self.plugin.update_screens(self)
        return bool(ok and same_message(media.getPlayingMessageObject(),target["message"]))

    def play(self, tracks, target):
        self.stop_wave()
        self.play_serial += 1
        token = self.play_serial
        def ready(fresh):
            if token != self.play_serial or not self.valid():
                return
            if fresh.get("unavailable") or fresh.get("message") is None:
                self.plugin.music_notice(self,str(fresh.get("unavailable") or "Аудиозапись пока недоступна"))
                return
            queue = [fresh if str(t["id"]) == str(target["id"]) else t for t in tracks]
            self.install_playlist(queue, fresh)
        self.refresh_track(target, ready)

    def refresh_track(self, target, callback):
        if self.downloads.local_file(target) is not None:
            self.downloads.bind_local_file(target)
            callback(target)
            return
        source=target.get("source")
        if source:
            message=target.get("message")
            contextual=bool(message is not None and int(message.getId())==int(source.get("message",0)) and int(message.getDialogId())==int(source.get("dialog",0)))
            if contextual and time.time()-target.get("fetched",0)<1800:
                callback(target)
            else:self.refresh_from_chat(target,callback)
            return
        if target.get("message") is not None and time.time()-target.get("fetched",0) < 2400:
            callback(target)
            return
        query = (target["artist"] + " " + target["title"])[:200]
        wanted = target["id"]
        def found(tracks, offset, error):
            fresh = next((t for t in tracks if str(t["id"]) == str(wanted)),None)
            if fresh is None:
                fresh = next((t for t in tracks if fingerprint(t) == fingerprint(target) and abs(t["duration"]-target["duration"]) < 10),None)
            if fresh is not None:
                # Keep the saved identity when Telegram returns a different copy.
                if wanted in self.collection.data["tracks"] and fresh["id"] == wanted:
                    self.keep(fresh)
                    self.save()
                callback(fresh)
            else:
                # Cached files can still play when search is temporarily offline.
                callback(target)
        self.search(query, "", found)

    def track_from_message(self,message):
        if int(message.currentAccount)!=self.account or not message.isMusic():return None
        document=message.getDocument()
        if document is None or field(document,"key") is not None:return None
        raw=message.messageOwner
        if int(field(field(raw,"media"),"ttl_seconds") or 0)>0:return None
        mid,did=int(message.getId()),int(message.getDialogId())
        if mid<=0 or did==0:return None
        try:title,artist=str(message.getMusicTitle()),str(message.getMusicAuthor())
        except Exception:title,artist="",""
        try:duration=int(message.getDuration())
        except Exception:duration=0
        audio=audio_metadata(document,title,artist,duration)
        if audio is None:return None
        # A document found in a chat is not an inline-bot result. Retain its
        # original positive message ID and peer in a separate local object.
        playback=copy_chat_message(message,self.account)
        result=self.make_track(playback.getDocument(),audio,str(audio.performer or ""))
        self.owned.pop(owned_message_key(result["message"]),None)
        result["message"]=playback
        source={"dialog":did,"message":mid,"user":self.user_id}
        peer=field(raw,"peer_id")
        channel=int(field(peer,"channel_id") or 0)
        if channel:
            source["channel"]=channel
            try:source["access_hash"]=int(field(self.controller.getInputPeer(did),"access_hash") or 0)
            except Exception:pass
        result["source"]=source
        result["genre"]=artist_genre(result["artist"],self.collection)
        result["source_parent"]=playback
        self.owned[owned_message_key(playback)]=result
        return result

    def refresh_from_chat(self,target,callback):
        source=target.get("source") or {}
        def unavailable(message):
            failed=dict(target)
            failed["unavailable"]=str(message)
            callback(failed)
        try:
            mid,did=int(source.get("message",0)),int(source.get("dialog",0))
            if mid<=0 or did==0:raise ValueError("Не сохранён адрес исходного сообщения")
            if int(source.get("user",self.user_id))!=self.user_id:
                raise ValueError("Песня импортирована из другого аккаунта")
            channel=int(source.get("channel",0))
            peer=None
            try:peer=self.controller.getInputPeer(did)
            except Exception:pass
            if not channel:channel=int(field(peer,"channel_id") or 0)
            if channel:
                request=TLRPC.TL_channels_getMessages()
                input_channel=None
                try:input_channel=self.controller.getInputChannel(channel)
                except Exception:pass
                saved_hash=int(source.get("access_hash",0) or field(peer,"access_hash") or 0)
                if input_channel is None or not int(field(input_channel,"channel_id") or 0) or (saved_hash and not int(field(input_channel,"access_hash") or 0)):
                    input_channel=TLRPC.TL_inputChannel()
                    input_channel.channel_id=channel
                    input_channel.access_hash=saved_hash
                request.channel=input_channel
            else:request=TLRPC.TL_messages_getMessages()
            try:
                message_id=TLRPC.TL_inputMessageID()
                message_id.id=mid
            except Exception:message_id=jclass("java.lang.Integer")(mid)
            request.id.add(message_id)
        except Exception as error:
            unavailable("Не удалось открыть исходное сообщение: "+str(error))
            return
        def done(tracks,offset,error):
            if tracks:callback(tracks[0])
            else:unavailable(error or "Исходное сообщение недоступно или песня удалена")
        job=SearchJob(self,done)
        self.jobs.append(job)
        def received(response):
            self.controller.putUsers(response.users,False)
            self.controller.putChats(response.chats,False)
            fresh=None
            for raw in java_items(response.messages):
                if int(raw.id)!=mid:continue
                message=MessageObject(self.account,raw,False,True)
                if int(message.getDialogId())!=did:continue
                candidate=self.track_from_message(message)
                if candidate and str(candidate["id"])==str(target["id"]):
                    fresh=candidate
                    break
            if fresh and str(target["id"]) in self.collection.data["tracks"]:
                self.keep(fresh)
                self.save()
            job.done([fresh] if fresh else [])
        job.send(request,received)

    def import_messages(self,playlist_id,messages):
        if playlist_id not in self.collection.data["playlists"]:return 0
        before=len(self.collection.data["playlists"][playlist_id]["ids"])
        ordered=sorted(messages,key=lambda message:(int(message.messageOwner.date),int(message.getId())))
        for message in ordered:
            track=self.track_from_message(message)
            if track is not None:
                self.keep(track)
                self.collection.add(playlist_id,track["id"])
        added=len(self.collection.data["playlists"][playlist_id]["ids"])-before
        self.changed()
        return added

    def prepare_collection(self,ids,callback,for_playback=True):
        # Decode stored Telegram documents in small UI-queue batches. Importing a
        # large chat must not make opening or playing its playlist freeze Android.
        if for_playback:
            self.play_serial+=1
            self.warming.clear()
        token=self.play_serial if for_playback else None
        keys=list(ids)
        tracks=[]
        def batch(position=0):
            if (token is not None and token!=self.play_serial) or not self.valid():return
            for key in keys[position:position+25]:
                track=self.materialize(key)
                if track is not None:tracks.append(track)
            position+=25
            if position<len(keys):run_on_ui_thread(lambda:batch(position),1)
            else:callback(tracks)
        run_on_ui_thread(batch,1)

    def refresh_local_next(self,current,previous,by_stop):
        pos=next((i for i,t in enumerate(self.local_queue) if same_message(t.get("message"),current)),-1)
        if pos<0:return False
        media=MediaController.getInstance()
        if previous and current.audioProgressSec>10:return False
        if by_stop and int(SharedConfig.repeatMode)==2:return False
        index=pos-1 if previous else pos+1
        if index<0 or index>=len(self.local_queue):
            if by_stop and int(SharedConfig.repeatMode)==0:return False
            index%=len(self.local_queue)
        if bool(SharedConfig.shuffleMusic):
            indices=[i for i in range(len(self.local_queue)) if i!=pos]
            if indices:index=random.choice(indices)
        target=self.local_queue[index]
        # An old saved reference must not force a search at the audio boundary
        # when the complete file is already in Telegram's cache.
        if self.downloads.local_file(target) is not None:return False
        source=target.get("source")
        message=target.get("message")
        contextual=not source or bool(message is not None and int(message.getId())==int(source.get("message",0)) and int(message.getDialogId())==int(source.get("dialog",0)))
        if contextual and time.time()-target.get("fetched",0)<1800:return False
        self.play_serial+=1
        self.warming.clear()
        token=self.play_serial
        expected_current=message_token(current)
        queue=list(self.local_queue)
        def ready(fresh):
            now=media.getPlayingMessageObject()
            if token!=self.play_serial or not self.valid() or message_token(now)!=expected_current:return
            if fresh.get("unavailable") or fresh.get("message") is None:
                self.plugin.music_notice(self,str(fresh.get("unavailable") or "Песня недоступна"))
                return
            updated=[fresh if t["id"]==target["id"] else t for t in queue]
            self.install_playlist(updated,fresh)
        self.refresh_track(target,ready)
        return True

    def sync_local_queue(self):
        media=MediaController.getInstance()
        current=media.getPlayingMessageObject()
        if self.wave_active or self.owned_track(current) is None:return
        fresh={str(t["id"]):t for t in self.local_queue if t.get("message") is not None}
        if str(current.getDocument().id) not in fresh:return
        index_field=media.getClass().getDeclaredField("currentPlaylistNum")
        index_field.setAccessible(True)
        native=media.getPlaylist()
        if any(str(item.getDocument().id) not in fresh for item in java_items(native)):return
        ordered=list(self.local_queue) if SharedConfig.playOrderReversed else list(reversed(self.local_queue))
        items=[current if str(t["id"])==str(current.getDocument().id) else t["message"] for t in ordered if t.get("message") is not None]
        active=native
        shuffled=None
        if SharedConfig.shuffleMusic:
            shuffled=field(media,"shuffledPlaylist")
            if shuffled is None:return
            replacements=[current if same_message(item,current) else fresh[str(item.getDocument().id)]["message"] for item in java_items(shuffled) if str(item.getDocument().id) in fresh]
            present={str(item.getDocument().id) for item in replacements}
            extra=[item for item in items if str(item.getDocument().id) not in present]
            replacements=replacements+extra if SharedConfig.playOrderReversed else extra+replacements
        native.clear()
        for item in items:native.add(item)
        if shuffled is not None:
            shuffled.clear()
            for item in replacements:shuffled.add(item)
            active=shuffled
        index_field.setInt(media,active.indexOf(current))
        mapping=field(media,"playlistMap")
        if mapping is not None:
            mapping.clear()
            for item in java_items(native):mapping.put(int(item.getId()),item)

    def warm_local_queue(self,current):
        if self.wave_active or not self.valid() or self.warming:return
        pos=next((i for i,t in enumerate(self.local_queue) if same_message(t.get("message"),current)),-1)
        if pos<0:return
        upcoming=self.local_queue[pos+1:pos+4]
        for target in upcoming:
            source=target.get("source")
            if not source:continue
            key=str(target["id"])
            if time.monotonic()-self.warm_failed.get(key,-1000)<60:continue
            if self.downloads.local_file(target) is not None:continue
            message=target.get("message")
            if message is not None and int(message.getId())==int(source.get("message",0)) and time.time()-target.get("fetched",0)<1800:continue
            token=self.play_serial
            self.warming.add(key)
            def ready(fresh,key=key,token=token):
                if token!=self.play_serial or not self.valid():return
                self.warming.discard(key)
                if fresh.get("unavailable") or fresh.get("message") is None:
                    self.warm_failed[key]=time.monotonic()
                else:
                    self.local_queue=[fresh if str(t["id"])==key else t for t in self.local_queue]
                    self.downloads.bind_local_file(fresh)
                    try:self.sync_local_queue()
                    except Exception:self.plugin.record_error("prepare next imported track")
                run_on_ui_thread(lambda:self.warm_local_queue(MediaController.getInstance().getPlayingMessageObject()) if token==self.play_serial else None,250)
            self.refresh_track(target,ready)
            break

    def observe(self, message=None):
        if not self.valid() or self.installing:
            return
        media = MediaController.getInstance()
        message = message if message is not None else media.getPlayingMessageObject()
        track = self.owned_track(message)
        if track is None:
            self.session = None
            if self.wave_active and message is not None and (self.wave_position>=0 or message!=self.baseline_message):
                self.stop_wave()
            return
        mid = int(message.getId())
        identity=message_token(message)
        now = time.monotonic()
        if self.session is None or self.session["id"] != identity:
            self.session = {"id":identity,"track":track,"last":now,"listened":0.0,"credited":False}
            self.collection.data["recent"].append({"id":track["id"],"fp":fingerprint(track),"at":time.time()})
            self.collection.data["recent"] = self.collection.data["recent"][-160:]
            self.keep(track)
            self.save()
        else:
            delta = max(0.0,min(2.0,now-self.session["last"]))
            self.session["last"] = now
            if not media.isMessagePaused() and not media.isDownloadingCurrentMessage():
                self.session["listened"] += delta
            threshold = min(240,max(20,track["duration"]*0.7))
            if not self.session["credited"] and self.session["listened"] >= threshold:
                self.session["credited"] = True
                self.collection.adjust(track["artist"],0.6)
                self.save()
        if self.is_wave_message(message):
            self.wave_position = next((i for i,t in enumerate(self.wave_queue) if int(t["message"].getId()) == mid),self.wave_position)
            if self.wave_position>25:
                self.wave_queue=self.wave_queue[self.wave_position-15:]
                self.wave_position=15
                self.sync_wave_playlist()
            if len(self.wave_queue)-self.wave_position-1 < 8 and self.attempts < 12 and not self.failures:
                self.fill_wave()
        elif self.wave_active and self.wave_position>=0:
            self.stop_wave()
        elif not self.wave_active:
            self.warm_local_queue(message)

    def dispose(self):
        self.stop_wave()
        if self.import_job:self.import_job.cancel()
        self.downloads.dispose()
        for job in list(self.jobs):
            job.cancel()
        if self.dirty:
            self.save(immediate=True)


class WaveSkipHook(MethodHook):
    def __init__(self, plugin, previous=False):
        self.plugin, self.previous = plugin, previous

    def before_hooked_method(self, param):
        if not self.plugin.active:
            return
        try:
            current = MediaController.getInstance().getPlayingMessageObject()
            if current is None:
                return
            owner = self.plugin.accounts.get(int(current.currentAccount))
            if owner is None or not owner.valid() or owner.owned_track(current) is None:
                return
            by_stop = bool(param.args[0]) if not self.previous and len(param.args) else False
            if owner.is_wave_message(current):
                expected_mid=int(current.getId())
                if by_stop and not self.previous:
                    if owner.allow_native_wave_end(current):return
                    # We're already in MediaController's own end callback.
                    # Complete the fallback on that same thread, and suppress
                    # native playback only after our transition succeeds.
                    owner.advance(False,True,expected_mid)
                    owner.python_transitions+=1
                    owner.last_transition="обработчик волны без отложенного запуска"
                    param.setResult(None)
                else:
                    param.setResult(None)
                    run_on_ui_thread(lambda:owner.advance(self.previous,by_stop,expected_mid))
            else:
                if not self.previous and not by_stop and owner.session and owner.session["listened"]<12:
                    owner.collection.adjust(owner.session["track"]["artist"],-0.2)
                    owner.save()
                if owner.refresh_local_next(current,self.previous,by_stop):
                    param.setResult(None)
        except Exception:
            self.plugin.record_error("wave next")


# Chaquopy proxy classes cannot be subclassed through an SDK proxy wrapper.
# Use a fresh direct proxy base, as with SearchEditor in the working prototype.
class PlaybackObserver(dynamic_proxy(jclass("org.telegram.messenger.NotificationCenter$NotificationCenterDelegate"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, notification_id, account, args):
        if not self.plugin.active:
            return
        def update():
            owner = self.plugin.accounts.get(int(account))
            if owner is not None:
                try:
                    if notification_id in self.plugin.cache_events:
                        owner.downloads.event(notification_id,args)
                    else:
                        owner.observe()
                except Exception:
                    self.plugin.record_error("playback signal")
        run_on_ui_thread(update)


# A local, editable discovery catalog. These are recommendation seeds rather than
# authoritative genre tags supplied by Telegram for individual recordings.
SUBGENRES = {
    "Русский рок": {
        "Классический": ["Кино", "ДДТ", "Наутилус Помпилиус", "Алиса", "Аквариум"],
        "Панк-рок": ["Король и Шут", "Порнофильмы", "Тараканы!", "Наив", "Пилот"],
        "Постпанк и новая волна": ["Кино", "Молчат Дома", "Буерак", "Плохо", "Дурной Вкус"],
        "Лирический": ["Сплин", "Би-2", "Земфира", "Смысловые Галлюцинации", "Ночные Снайперы"],
    },
    "Альтернатива": {
        "Альтернативный рок": ["Louna", "Animal ДжаZ", "Слот", "Guano Apes", "Placebo"],
        "Рэп-рок": ["Anacondaz", "Noize MC", "Rage Against the Machine", "Limp Bizkit", "Linkin Park"],
        "Поп-панк": ["Green Day", "blink-182", "Sum 41", "The Offspring", "Пошлая Молли"],
        "Постхардкор": ["Enter Shikari", "Dance Gavin Dance", "Silverstein", "Sleeping With Sirens"],
    },
    "Русский рэп": {
