def blend_color(base,tint,amount):
    b,t=int(base)&0xffffffff,int(tint)&0xffffffff
    channels=[int(((b>>shift)&255)*(1-amount)+((t>>shift)&255)*amount) for shift in (16,8,0)]
    return argb(0xff000000|(channels[0]<<16)|(channels[1]<<8)|channels[2])


def color_luminance(value):
    values=[((int(value)>>shift)&255)/255 for shift in (16,8,0)]
    linear=[v/12.92 if v<=0.04045 else ((v+0.055)/1.055)**2.4 for v in values]
    return sum(a*b for a,b in zip(linear,(0.2126,0.7152,0.0722)))


def contrast_ink(value):
    return argb(0xff000000) if color_luminance(value)>0.179 else -1


def color_contrast(first,second):
    low,high=sorted((color_luminance(first),color_luminance(second)))
    return (high+0.05)/(low+0.05)


def readable_ink(background,preferred=None,secondary=False):
    if preferred is not None and color_contrast(background,preferred)>=4.5:return argb(preferred)
    ink=contrast_ink(background)
    if secondary:
        for amount in (0.70,0.8,0.9,1.0):
            muted=blend_color(background,ink,amount)
            if color_contrast(background,muted)>=4.5:return muted
    return ink


def parse_color(value):
    if isinstance(value,int) and not isinstance(value,bool):return argb(0xff000000|(value&0xffffff))
    if not isinstance(value,str):return None
    value=value.strip().lstrip("#")
    if not re.fullmatch(r"[0-9a-fA-F]{6}",value):return None
    return argb(0xff000000|int(value,16))


def color_hex(value):return "#%06X"%(int(value)&0xffffff)


def custom_colors(raw):
    try:
        raw=json.loads(raw) if isinstance(raw,str) else raw
        if not isinstance(raw,dict):return {"parts":{},"genres":{}}
        result={"parts":{},"genres":{}}
        overall=parse_color(raw.get("all"))
        if overall is not None:result["all"]=color_hex(overall)
        for group,allowed in (("parts",COLOR_PARTS),("genres",GENRE_COLORS)):
            values=raw.get(group,{})
            if not isinstance(values,dict):continue
            for key,value in values.items():
                color_value=parse_color(value)
                if key in allowed and color_value is not None:result[group][key]=color_hex(color_value)
        return result
    except Exception:return {"parts":{},"genres":{}}


def artist_genre(artist,collection,query=""):
    selected=list(collection.data.get("genres",[]))
    selected+= [key.split("/",1)[0] for key in collection.data.get("subgenres",[])]
    selected=list(dict.fromkeys(parent for parent in selected if parent in GENRE_COLORS))
    names={normalized(name) for name in artist_names(artist)}|{normalized(query)}
    matches=[]
    for parent,artists in GENRES.items():
        catalog=list(artists)+[a for values in SUBGENRES.get(parent,{}).values() for a in values]
        if any(normalized(name) in names for name in catalog):matches.append(parent)
    for parent in selected:
        if parent in matches:return parent
    if matches:return matches[0]
    return selected[0] if len(selected)==1 else ""


def genre_palette(genre,overrides=None):
    parent=str(genre or "").split("/",1)[0]
    if parent not in GENRE_COLORS:return GRAY_WAVE_PALETTE
    custom=custom_colors(overrides)
    base=parse_color(custom["genres"].get(parent))
    if base is None:base=argb(GENRE_COLORS[parent])
    rgb=[(int(base)>>shift)&255 for shift in (16,8,0)]
    scale=min(1.0,188/max(1,max(rgb)))
    base=argb(0xff000000|int(rgb[0]*scale)<<16|int(rgb[1]*scale)<<8|int(rgb[2]*scale))
    return tuple(blend_color(argb(0xff08080b),base,amount) for amount in (0.23,1.0,0.65,0.12))


def screen_design(theme,page,telegram_background,overrides=None):
    if theme not in MUSIC_THEMES:
        theme="paper" if color_luminance(telegram_background)>0.35 else "night"
    result={key:argb(value) if isinstance(value,int) and not isinstance(value,bool) else value for key,value in MUSIC_THEMES[theme].items()}
    accents=PAGE_ACCENTS.get(page,PAGE_ACCENTS["home"])
    result["accent"]=argb(accents[1 if result["light"] else 0])
    custom=custom_colors(overrides)
    overall=parse_color(custom.get("all"))
    if overall is not None:
        if result["light"]:
            result["background"]=blend_color(-1,overall,0.09)
            result["surface"]=blend_color(-1,overall,0.035)
            result["raised"]=blend_color(-1,overall,0.16)
        else:
            result["background"]=blend_color(argb(0xff08090c),overall,0.10)
            result["surface"]=blend_color(argb(0xff111218),overall,0.15)
            result["raised"]=blend_color(argb(0xff1e2028),overall,0.21)
        result["accent"]=overall
    for key,value in custom["parts"].items():result[key]=parse_color(value)
    result["buttons"]=result.get("buttons",result["accent"])
    result["wave_button"]=result.get("wave_button",argb(0xff9282f6))
    result["foreground"]=readable_ink(result["background"],result["foreground"])
    result["muted"]=readable_ink(result["background"],result["muted"],True)
    for block in ("navigation","player","search"):
        result[block]=result.get(block,result["surface"])
    result["accent"]=readable_ink(result["surface"],result["accent"])
    result["wash"]=blend_color(result["background"],result["accent"],0.13 if result["light"] else 0.16)
    result["header"]=result.get("header",result["wash"])
    result["selected"]=blend_color(result["surface"],result["accent"],0.14)
    result["key"]=theme
    return result


def music_typefaces(style):
    family=MUSIC_FONTS.get(style,MUSIC_FONTS["rounded"])[2]
    try:
        body=family
        return {"body":Typeface.create(body,0),"medium":Typeface.create(body,1),
            "title":Typeface.create(family,1),"numbers":Typeface.create("sans-serif-medium",0)}
    except Exception:
        return {"body":Typeface.DEFAULT,"medium":Typeface.DEFAULT,"title":Typeface.DEFAULT,"numbers":Typeface.DEFAULT}


@java_subclass(jclass("android.widget.BaseAdapter"))
class FontListAdapter(Base):
    def __init__(self,screen,keys):self.screen,self.keys=screen,list(keys)

    @joverride("getCount", [])
    def count(self):return len(self.keys)

    @joverride("getItem", ["int"])
    def item(self,position):return jclass("java.lang.String")(MUSIC_FONTS[self.keys[int(position)]][0])

    @joverride("getItemId", ["int"])
    def item_id(self,position):return int(position)

    def make_view(self,position):
        key=self.keys[int(position)]
        label=self.screen.label(MUSIC_FONTS[key][0],16,on=self.screen.surface)
        label.setTypeface(music_typefaces(key)["body"])
        label.setIncludeFontPadding(True)
        label.setGravity(Gravity.CENTER_VERTICAL)
        label.setPadding(dp(14),dp(12),dp(14),dp(12))
        label.setMinHeight(dp(52))
        label.setBackground(self.screen.rounded(self.screen.surface,14))
        return label

    @joverride("getView", ["int","android.view.View","android.view.ViewGroup"])
    def view(self,position,convert,parent):return self.make_view(position)

    @joverride("getDropDownView", ["int","android.view.View","android.view.ViewGroup"])
    def dropdown_view(self,position,convert,parent):return self.make_view(position)


class FontSelectionListener(dynamic_proxy(jclass("android.widget.AdapterView$OnItemSelectedListener"))):
    def __init__(self,screen,keys,generation):
        super().__init__()
        self.screen,self.keys,self.generation=screen,list(keys),generation
    def onItemSelected(self,parent,view,position,item_id):
        screen=self.screen
        if screen.closed or not screen.owner.valid() or screen.appearance_serial!=self.generation:return
        if int(position)<0 or int(position)>=len(self.keys):return
        key=self.keys[int(position)]
        if key!=screen.plugin.get_setting("design_font","rounded"):screen.set_appearance("design_font",key)
    def onNothingSelected(self,parent):pass


class ColorSliderListener(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
    def __init__(self,editor,index):
        super().__init__()
        self.editor,self.index=editor,index
    def onProgressChanged(self,seekbar,progress,from_user):
        if not self.editor.updating and not self.editor.closed:self.editor.slider_changed(self.index,int(progress))
    def onStartTrackingTouch(self,seekbar):pass
    def onStopTrackingTouch(self,seekbar):pass


class ColorHexWatcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
    def __init__(self,editor):
        super().__init__()
        self.editor=editor
    def beforeTextChanged(self,text,start,count,after):pass
    def onTextChanged(self,text,start,before,count):pass
    def afterTextChanged(self,text):
        if not self.editor.updating and not self.editor.closed:self.editor.hex_changed(str(text))


class ColorEditor:
    def __init__(self,screen,value):
        self.screen,self.value=screen,argb(value)
        self.closed,self.updating,self.valid=False,False,True
        self.builder=None
        self.listeners=[]
        self.view=LinearLayout(screen.context);self.view.setOrientation(1)
        self.view.setPadding(dp(18),dp(12),dp(18),dp(10))
        self.view.setBackgroundColor(screen.surface)
        self.preview=screen.label("Ayu Music",23,bold=True,on=value)
        self.preview.setGravity(Gravity.CENTER)
        self.view.addView(self.preview,LinearLayout.LayoutParams(MATCH,dp(76)))
        self.hex=EditText(screen.context)
        self.hex.setSingleLine(True);self.hex.setSelectAllOnFocus(True)
        self.hex.setHint("#RRGGBB")
        self.hex.setTextColor(readable_ink(screen.raised,screen.foreground))
        self.hex.setHintTextColor(readable_ink(screen.raised,screen.muted,True))
        self.hex.setTextSize(16.0);self.hex.setTypeface(Typeface.MONOSPACE)
        self.hex.setPadding(dp(10),dp(8),dp(10),dp(8))
        self.hex.setBackground(screen.rounded(screen.raised,12))
        self.hex.setText(color_hex(value))
        self.watcher=ColorHexWatcher(self);self.hex.addTextChangedListener(self.watcher)
        hp=LinearLayout.LayoutParams(MATCH,dp(50));hp.topMargin=dp(12)
        self.view.addView(self.hex,hp)
        self.status=screen.label("Оттенок, насыщенность и яркость",12,True,on=screen.surface)
        self.status.setPadding(0,dp(8),0,dp(4));self.view.addView(self.status)
        self.sliders=[]
        for i,(title,maximum) in enumerate((("Оттенок",360),("Насыщенность",100),("Яркость",100))):
            self.view.addView(screen.label(title,12,on=screen.surface))
            slider=jclass("android.widget.SeekBar")(screen.context)
            slider.setMax(maximum)
            listener=ColorSliderListener(self,i)
            self.listeners.append(listener);slider.setOnSeekBarChangeListener(listener)
            try:
                tint=jclass("android.content.res.ColorStateList").valueOf(screen.accent)
                slider.setProgressTintList(tint);slider.setThumbTintList(tint)
            except Exception:pass
            self.sliders.append(slider)
            self.view.addView(slider,LinearLayout.LayoutParams(MATCH,dp(42)))
        self.update(value,True)

    def update(self,value,update_sliders,update_hex=True):
        self.updating=True
        try:
            self.value=argb(value);self.valid=True
            self.preview.setBackground(self.screen.rounded(value,18))
            self.preview.setTextColor(contrast_ink(value))
            if update_hex:self.hex.setText(color_hex(value))
            self.status.setText("Оттенок, насыщенность и яркость")
            if update_sliders:
                rgb=[((int(value)>>shift)&255)/255 for shift in (16,8,0)]
                hsv=colorsys.rgb_to_hsv(*rgb)
                for slider,progress in zip(self.sliders,(round(hsv[0]*360),round(hsv[1]*100),round(hsv[2]*100))):slider.setProgress(int(progress))
            if self.builder:
                button=self.builder.get_button(-1)
                if button is not None:button.setEnabled(True)
        finally:self.updating=False

    def slider_changed(self,index,progress):
        hsv=[self.sliders[0].getProgress()/360,self.sliders[1].getProgress()/100,self.sliders[2].getProgress()/100]
        hsv[index]=progress/(360 if index==0 else 100)
        r,g,b=[round(v*255) for v in colorsys.hsv_to_rgb(*hsv)]
        self.update(argb(0xff000000|int(r)<<16|int(g)<<8|int(b)),False)

    def hex_changed(self,text):
        value=parse_color(text)
        if value is None:
            self.valid=False
            self.status.setText("Введи цвет в формате #RRGGBB")
            if self.builder:
                button=self.builder.get_button(-1)
                if button is not None:button.setEnabled(False)
        else:self.update(value,True,False)

    def close(self):self.closed=True


class HeaderHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.attach_button(param.thisObject)
        except Exception:
            self.plugin.record_error("header")


class SearchEditor(dynamic_proxy(EditorListener)):
    def __init__(self, screen):
        super().__init__()
        self.screen = screen

    def onEditorAction(self, view, action_id, event):
        if action_id in (3, 6) or (event is not None and event.getAction() == 0 and event.getKeyCode() == 66):
            self.screen.start_search()
            return True
        return False


@java_subclass(BaseFragment)
class MusicScreen(Base):
    def __init__(self, plugin, account):
        self.plugin, self.account = plugin, int(account)
        self.owner = plugin.music_account(self.account)
        self.closed, self.visible = False, False
        self.root, self.ticker = None, None
        self.page, self.favorite_mode, self.playlist_id = "home", "tracks", None
        self.listeners, self.content_listeners, self.rows = [], [], []
        self.query, self.offset, self.search_tracks = "", "", []
        self.search_busy, self.search_serial, self.search_job = False, 0, None
        self.search_status = "Введи песню или исполнителя"
        self.cache_labels = {}
        self.list_limit = 80
        self.preference_editors = []
        self.backdrop = None
        self.wave_draft,self.artist_picker = None,None
        self.wave_return,self.appearance_return = "home","home"
        self.start_after_settings = False
        self.font_key,self.fonts = None,{}
        self.row_shells,self.row_states = {},{}
        self.appearance_serial=0
        self.colors_expanded=False
        self.color_editors=[]

    @joverride("createView", ["android.content.Context"])
    def create_view(self, context):
        try:
            return self.build_view(context)
        except Exception:
            self.plugin.record_error("screen")
            root = LinearLayout(context)
            root.setPadding(dp(20),dp(20),dp(20),dp(20))
            text = TextView(context)
            text.setText("Не удалось открыть экран. Открой настройки Ayu Music → Диагностика.")
            text.setTextColor(color("key_windowBackgroundWhiteBlackText",-1))
            root.addView(text)
            self.java.setFragmentView(root)
            return root

    @joverride("onResume", [])
    def resume(self):
        super().resume()
        self.visible = True
        if self.backdrop:self.backdrop.update(MediaController.getInstance().getPlayingMessageObject())
        if self.root is not None and self.ticker is not None:
            self.root.removeCallbacks(self.ticker)
            self.root.post(self.ticker)

    @joverride("onPause", [])
    def pause(self):
        self.visible = False
        if self.backdrop:self.backdrop.motion(False)
        if self.root is not None and self.ticker is not None:
            self.root.removeCallbacks(self.ticker)
        super().pause()

    @joverride("onFragmentDestroy", [])
    def destroy(self):
        self.dispose()
        super().destroy()

    def dispose(self):
        self.closed, self.visible = True, False
        self.appearance_serial+=1
        for editor in self.color_editors:editor.close()
        self.color_editors.clear()
        if self.backdrop:self.backdrop.close()
        for editor in self.preference_editors:editor.close()
        self.preference_editors.clear()
        if self.search_job:
            self.search_job.cancel()
        if self.root is not None and self.ticker is not None:
            self.root.removeCallbacks(self.ticker)
        if self in self.plugin.screens:
            self.plugin.screens.remove(self)

    def click(self, view, callback, content=False):
        def safe_click(v):
            if self.closed or not self.owner.valid():
                return
            try:
                callback()
            except Exception:
                self.plugin.record_error("click")
                self.notify("Ошибка. Подробности в диагностике Ayu Music.")
        listener = OnClickListener(safe_click)
        (self.content_listeners if content else self.listeners).append(listener)
        view.setOnClickListener(listener)

    def label(self, text, size=15, secondary=False, bold=False, on=None):
        label = TextView(self.context)
        label.setText(str(text))
        label.setTextSize(float(size))
        label.setTextColor(readable_ink(self.background if on is None else on,self.muted if secondary else self.foreground,secondary))
        label.setGravity(Gravity.CENTER_VERTICAL)
        label.setIncludeFontPadding(False)
        label.setTypeface(self.fonts.get("medium" if bold else "body",Typeface.DEFAULT))
        if bold and not self.fonts:label.setTypeface(Typeface.DEFAULT,Typeface.BOLD)
        return label

    def apply_design(self):
        theme = self.plugin.get_setting("design_theme","auto")
        self.design = screen_design(theme,self.page,color("key_windowBackgroundGray",-15724528),self.plugin.get_setting("design_colors",None))
        for key in ("foreground","muted","background","surface","accent","raised"):
            setattr(self,key,self.design[key])
        font_key = self.plugin.get_setting("design_font","rounded")
        if font_key != self.font_key:
            self.font_key = font_key
            self.fonts = music_typefaces(font_key)

    def heading(self,text,size=30,on=None):
        view = self.label(text,size,bold=True,on=on)
        view.setTypeface(self.fonts.get("title",Typeface.DEFAULT))
        try:view.setLetterSpacing(-0.025)
        except Exception:pass
        return view

    def page_intro(self,title,subtitle="",eyebrow=""):
        if eyebrow:
            tag = self.padded_text(eyebrow.upper(),10,bold=True)
            tag.setTextColor(self.accent)
            try:tag.setLetterSpacing(0.16)
            except Exception:pass
        view = self.heading(title)
        view.setPadding(dp(4),dp(4),dp(4),dp(8))
        self.content.addView(view,LinearLayout.LayoutParams(MATCH,WRAP))
        if subtitle:self.padded_text(subtitle,13,True)

    def empty_state(self,title,description,symbol="♫"):
        card = LinearLayout(self.context)
        card.setOrientation(1)
        card.setGravity(Gravity.CENTER)
        card.setPadding(dp(22),dp(26),dp(22),dp(26))
        card.setBackground(self.rounded(self.surface,24))
        for text,size,secondary in ((symbol,34,False),(title,19,False),(description,13,True)):
            view = self.heading(text,size,on=self.surface) if size==19 else self.label(text,size,secondary,on=self.surface)
            view.setGravity(Gravity.CENTER)
            view.setPadding(0,dp(7),0,dp(7))
            if size==34:view.setTextColor(self.accent)
            card.addView(view,LinearLayout.LayoutParams(MATCH,WRAP))
        params = LinearLayout.LayoutParams(MATCH,WRAP)
        params.topMargin=params.bottomMargin=dp(12)
        self.content.addView(card,params)

    def primary_action(self,text,callback):
        view = self.label(text,14,bold=True)
        view.setGravity(Gravity.CENTER)
        view.setPadding(dp(14),dp(12),dp(14),dp(12))
        view.setMinHeight(dp(50))
        view.setTextColor(contrast_ink(self.design["buttons"]))
        view.setBackground(self.rounded(self.design["buttons"],18))
        self.click(view,callback,True)
        params=LinearLayout.LayoutParams(MATCH,WRAP)
        params.topMargin=dp(8);params.bottomMargin=dp(12)
        self.content.addView(view,params)
        return view

    def rounded(self, fill, radius=14):
        drawable = GradientDrawable()
        drawable.setColor(fill)
        drawable.setCornerRadius(float(dp(radius)))
        return drawable

    def button(self,text,callback,width=48,content=False):
        view = self.label(text,20,on=self.surface)
        view.setGravity(Gravity.CENTER)
        view.setMinHeight(dp(48))
        view.setContentDescription({"▶":"Воспроизвести","Ⅱ":"Пауза","›":"Следующий трек","♡":"В любимое плагина","♥":"Убрать из любимого плагина","⋮":"Действия с треком"}.get(text,text))
        view.setBackground(self.rounded(self.surface))
        self.click(view,callback,content)
        view.setLayoutParams(LinearLayout.LayoutParams(dp(width),dp(48)))
        return view

    def padded_text(self,text,size=15,secondary=False,bold=False):
        label = self.label(text,size,secondary,bold)
        label.setPadding(dp(6),dp(8),dp(6),dp(8))
        self.content.addView(label,LinearLayout.LayoutParams(MATCH,WRAP))
        return label

    def build_view(self,context):
        self.context = context
        self.apply_design()
        bar = self.java.getActionBar()
        bar.setTitle("Ayu Music")
        bar.setBackButtonImage(resource(context,"ic_ab_back"))
        if bar.getBackButton() is not None:
            self.click(bar.getBackButton(),self.back)
        menu = bar.createMenu()
        icon = resource(context,"msg_search")
        item = menu.addItemWithWidth(BUTTON_ID+1,icon,dp(48)) if icon else menu.addItem(BUTTON_ID+1,"⌕")
        item.setContentDescription("Поиск музыки")
        self.click(item,lambda:self.show_page("search"))
        icon = resource(context,"msg_theme","msg_settings")
        self.appearance_item = menu.addItemWithWidth(BUTTON_ID+2,icon,dp(48)) if icon else menu.addItem(BUTTON_ID+2,"◐")
        self.appearance_item.setContentDescription("Облик плагина")
        self.click(self.appearance_item,self.open_appearance)

        root = FrameLayout(context)
        root.setBackgroundColor(self.background)
        self.root = root
        self.backdrop = WaveBackdrop(self,root)
        column = LinearLayout(context)
        column.setOrientation(1)
        body_params = FrameLayout.LayoutParams(MATCH,MATCH)
        body_params.bottomMargin = dp(166)
        self.body_params,self.body_column = body_params,column
        root.addView(column,body_params)
        self.search_bar = LinearLayout(context)
        self.search_bar.setGravity(Gravity.CENTER_VERTICAL)
        self.search_bar.setPadding(dp(12),dp(12),dp(12),dp(8))
        self.search_input = EditText(context)
        self.search_input.setTextColor(self.foreground)
        self.search_input.setHintTextColor(self.muted)
        self.search_input.setTextSize(16.0)
        self.search_input.setSingleLine(True)
        self.search_input.setImeOptions(3)
        self.search_input.setHint("Песня или исполнитель")
        self.search_input.setPadding(dp(14),0,dp(8),0)
        self.search_input.setBackground(self.rounded(self.surface))
        self.search_input.setText(str(self.plugin.get_setting("last_query","")))
        self.editor_listener = SearchEditor(self)
        self.search_input.setOnEditorActionListener(self.editor_listener)
        self.search_bar.addView(self.search_input,LinearLayout.LayoutParams(0,dp(50),1.0))
        find = self.button("Найти",self.start_search,76)
        find.setTextSize(14.0)
        find.setTextColor(self.accent)
        params = LinearLayout.LayoutParams(dp(76),dp(50))
        params.leftMargin = dp(8)
        self.search_bar.addView(find,params)
        self.find_button = find
        column.addView(self.search_bar,LinearLayout.LayoutParams(MATCH,WRAP))
        scroll = ScrollView(context)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        self.scroll = scroll
        self.content = LinearLayout(context)
        self.content.setOrientation(1)
        self.content.setPadding(dp(12),dp(6),dp(12),dp(12))
        scroll.addView(self.content,ScrollView.LayoutParams(MATCH,WRAP))
        column.addView(scroll,LinearLayout.LayoutParams(MATCH,0,1.0))
        self.editor_host = LinearLayout(context)
        self.editor_host.setOrientation(1)
        self.editor_host.setVisibility(View.GONE)
        column.addView(self.editor_host,LinearLayout.LayoutParams(MATCH,0,1.0))

        player = LinearLayout(context)
        player.setGravity(Gravity.CENTER_VERTICAL)
        player.setPadding(dp(12),dp(8),dp(8),dp(8))
        player.setBackground(self.rounded(self.surface,23))
        player.setElevation(float(dp(6)))
        self.player = player
        info = LinearLayout(context)
        info.setOrientation(1)
        self.player_title = self.label("Выбери трек",15,bold=True)
        self.player_subtitle = self.label("Включи волну или найди песню",12,True)
        for label in (self.player_title,self.player_subtitle):
            label.setSingleLine(True)
            label.setEllipsize(TruncateAt.END)
            info.addView(label)
        self.click(info,self.show_player)
        player.addView(info,LinearLayout.LayoutParams(0,WRAP,1.0))
        self.player_heart = self.button("♡",self.like_playing,42)
        self.play_button = self.button("▶",self.toggle_play,44)
        player.addView(self.player_heart)
        player.addView(self.play_button)
        self.player_next = self.button("›",self.next_track,42)
        player.addView(self.player_next)
        self.player_more=self.button("⋮",self.playing_actions,40)
        self.player_more.setTypeface(Typeface.DEFAULT)
        self.player_more.setContentDescription("Действия с текущей песней")
        player.addView(self.player_more)
        player_params = FrameLayout.LayoutParams(MATCH,dp(66),Gravity.BOTTOM)
        player_params.leftMargin = player_params.rightMargin = dp(16)
        player_params.bottomMargin = dp(92)
        root.addView(player,player_params)

        navigation = LinearLayout(context)
        navigation.setPadding(dp(6),dp(5),dp(6),dp(5))
        navigation.setGravity(Gravity.CENTER_VERTICAL)
        navigation.setBackground(self.rounded(self.surface,34))
        navigation.setElevation(float(dp(9)))
        self.navigation = navigation
        self.nav_items = {}
        for key,title,icon in (("home","Главная","msg_home"),("search","Поиск","msg_search"),("favorites","Медиатека","msg_saved")):
            tab = LinearLayout(context)
            tab.setOrientation(1)
            tab.setGravity(Gravity.CENTER)
            picture = jclass("android.widget.ImageView")(context)
            picture.setImageResource(resource(context,icon))
            tab.addView(picture,LinearLayout.LayoutParams(dp(24),dp(24)))
            text = self.label(title,11)
            text.setGravity(Gravity.CENTER)
            tab.addView(text,LinearLayout.LayoutParams(MATCH,dp(20)))
            tab.setContentDescription(title)
            self.click(tab,lambda key=key:self.show_page(key))
            navigation.addView(tab,LinearLayout.LayoutParams(0,dp(56),1.0))
            self.nav_items[key]=(tab,picture,text)
        self.home_tab = self.nav_items["home"][2]
        self.favorite_tab = self.nav_items["favorites"][2]
        nav_params = FrameLayout.LayoutParams(MATCH,dp(68),Gravity.BOTTOM)
        nav_params.leftMargin = nav_params.rightMargin = dp(28)
        nav_params.bottomMargin = dp(12)
        root.addView(navigation,nav_params)
        self.edit_actions = LinearLayout(context)
        self.edit_actions.setPadding(dp(16),dp(8),dp(16),dp(8))
        self.edit_cancel = self.button("Отмена",self.cancel_edit,150)
        self.edit_accept = self.button("Сохранить",self.commit_edit,150)
        for view in (self.edit_cancel,self.edit_accept):
            view.setTextSize(14.0)
            self.edit_actions.addView(view,LinearLayout.LayoutParams(0,dp(50),1.0))
        edit_params = FrameLayout.LayoutParams(MATCH,dp(72),Gravity.BOTTOM)
        root.addView(self.edit_actions,edit_params)
        self.ticker = R(self.update_player)
        self.java.setFragmentView(root)
        self.render()
        return root

    def back(self):
        if self.page in ("wave_settings","artists","appearance"):
            self.cancel_edit()
        elif self.page=="playlist":
            self.show_page("favorites")
        elif self.page!="home":
            self.show_page("home")
        else:
            self.java.finishFragment()

    def notify(self,text):
        Toast.makeText(self.context,str(text),Toast.LENGTH_LONG).show()

    def show_page(self,page):
        if self.page=="artists" and page!="artists":self.close_artist_picker()
        if self.page=="search" and page!="search":AndroidUtilities.hideKeyboard(self.search_input)
        if self.page!=page:self.list_limit=80
        changed=self.page!=page
        self.page = page
        self.render()
        if changed:self.scroll.scrollTo(0,0)

    def render(self):
        if self.closed or self.root is None or not hasattr(self,"content"):
            return
        self.apply_design()
        self.content.removeAllViews()
        self.content_listeners.clear()
        self.rows.clear()
        self.row_shells.clear();self.row_states.clear()
        self.cache_labels.clear()
        self.wave_label = None
        self.wave_symbol = None
        self.shake_button = None
        self.search_bar.setVisibility(View.VISIBLE if self.page=="search" else View.GONE)
        home = self.page=="home"
        editing=self.page in ("wave_settings","artists","appearance")
        self.edit_actions.setVisibility(View.VISIBLE if editing else View.GONE)
        self.player.setVisibility(View.GONE if editing else View.VISIBLE)
        self.navigation.setVisibility(View.GONE if editing else View.VISIBLE)
        self.body_params.bottomMargin=dp(76 if editing else 166)
        self.body_column.setLayoutParams(self.body_params)
        self.editor_host.setVisibility(View.VISIBLE if self.page=="artists" else View.GONE)
        self.scroll.setVisibility(View.GONE if self.page=="artists" else View.VISIBLE)
        self.appearance_item.setVisibility(View.GONE if editing else View.VISIBLE)
        self.edit_actions.setBackgroundColor(self.background)
        self.edit_cancel.setTextColor(self.muted)
        self.edit_cancel.setBackgroundColor(0)
        self.edit_cancel.setVisibility(View.GONE if self.page=="appearance" else View.VISIBLE)
        self.edit_accept.setText("Выбрать" if self.page=="artists" else "Готово" if self.page=="appearance" else "Сохранить")
        self.edit_accept.setBackground(self.rounded(self.design["buttons"],18))
        self.edit_accept.setTextColor(contrast_ink(self.design["buttons"]))
        self.edit_accept.setTypeface(self.fonts["medium"])
        self.edit_cancel.setTypeface(self.fonts["medium"])
        self.root.setBackground(GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,jarray(jint)([self.design["wash"],self.background,self.background])))
        self.search_input.setTextColor(readable_ink(self.design["search"],self.foreground))
        self.search_input.setHintTextColor(readable_ink(self.design["search"],self.muted,True))
        self.search_input.setTypeface(self.fonts["body"])
        self.search_input.setBackground(self.rounded(self.design["search"],20))
        self.find_button.setBackground(self.rounded(self.design["buttons"],20))
        self.find_button.setTextColor(contrast_ink(self.design["buttons"]))
        self.find_button.setTypeface(self.fonts["medium"])
        current_tab = "favorites" if self.page=="playlist" else "home" if editing or self.page=="wave_queue" else self.page
        overrides=custom_colors(self.plugin.get_setting("design_colors",None))
        customized=bool(overrides.get("all"))
        player_fill=argb(0xff222226) if home and not customized and "player" not in overrides["parts"] else self.design["player"]
        nav_fill=argb(0xff222226) if home and not customized and "navigation" not in overrides["parts"] else self.design["navigation"]
        ink=readable_ink(player_fill,self.foreground)
        muted=readable_ink(player_fill,self.muted,True)
        self.player.setBackground(self.rounded(player_fill,23))
        self.player_fill=player_fill
        self.navigation.setBackground(self.rounded(nav_fill,34))
        self.player_title.setTextColor(ink)
        self.player_subtitle.setTextColor(muted)
        self.player_title.setTypeface(self.fonts["medium"])
        self.player_subtitle.setTypeface(self.fonts["body"])
        for child in (self.player_heart,self.play_button,self.player_next,self.player_more):
            child.setBackgroundColor(0)
            child.setTextColor(ink)
        for key,(tab,picture,text) in self.nav_items.items():
            selected_fill=blend_color(nav_fill,self.accent,0.15)
            tint=readable_ink(selected_fill if key==current_tab else nav_fill,self.accent if key==current_tab else self.muted,key!=current_tab)
            tab.setBackground(self.rounded(selected_fill if key==current_tab else 0,28))
            picture.setColorFilter(tint)
            text.setTextColor(tint)
            text.setTypeface(self.fonts["medium"])
        self.content.setPadding(dp(18),dp(8),dp(18),dp(18))
        title = {"home":"Ayu Music","favorites":"Медиатека","search":"Поиск музыки","playlist":"Плейлист","wave_queue":"Дальше в волне","wave_settings":"Твоя волна","artists":"Любимые исполнители","appearance":"Облик"}[self.page]
        self.java.getActionBar().setTitle(title)
        try:
            bar = self.java.getActionBar()
            header=argb(0xff111114) if home and not customized and "header" not in overrides["parts"] else self.design["header"]
            bar.setBackgroundColor(header)
            bar.setTitleColor(readable_ink(header,self.foreground))
            bar.setItemsColor(readable_ink(header,self.foreground),False)
            if bar.getTitleTextView() is not None:bar.getTitleTextView().setTypeface(self.fonts["medium"])
        except Exception:pass
        if self.page=="home": self.render_home()
        elif self.page=="favorites": self.render_favorites()
        elif self.page=="playlist": self.render_playlist()
        elif self.page=="wave_queue": self.render_wave_queue()
        elif self.page=="wave_settings":self.render_wave_settings()
        elif self.page=="artists":self.render_artists()
        elif self.page=="appearance":self.render_appearance()
        else: self.render_search()
        self.refresh_player()

    def render_home(self):
        seed=self.owner.wave_seed
        grouped=self.owner.wave_collection
        custom=bool(seed or grouped)
        stage = LinearLayout(self.context)
        stage.setOrientation(1)
        stage.setGravity(Gravity.CENTER)
        stage.setMinimumHeight(dp(310))
        stage.setPadding(dp(10),dp(20),dp(10),dp(20))
        title = self.heading(self.owner.wave_heading(),42)
        title.setTextColor(-1)
        title.setGravity(Gravity.CENTER)
        title.setSingleLine(True)
        try:title.setAutoSizeTextTypeUniformWithConfiguration(28,46,1,2)
        except Exception:pass
        stage.addView(title,LinearLayout.LayoutParams(MATCH,dp(66)))
        caption = self.label(self.owner.wave_caption(),14)
        caption.setTextColor(-1)
        caption.setGravity(Gravity.CENTER)
        caption.setMaxLines(2)
        caption.setEllipsize(TruncateAt.END)
        stage.addView(caption,LinearLayout.LayoutParams(MATCH,dp(52 if custom else 32)))
        symbol = self.label("▶",44,bold=True)
        symbol.setGravity(Gravity.CENTER)
        symbol.setTextColor(contrast_ink(self.design["wave_button"]))
        symbol.setIncludeFontPadding(False)
        symbol.setBackground(self.rounded(self.design["wave_button"],52))
        symbol.setContentDescription("Включить или приостановить волну")
        self.click(symbol,self.wave_click,True)
        play_params = LinearLayout.LayoutParams(dp(88 if custom else 104),dp(88 if custom else 104))
        play_params.topMargin = dp(16 if custom else 24)
        play_params.bottomMargin = dp(16 if custom else 20)
        stage.addView(symbol,play_params)
        self.wave_symbol = symbol
        shake = self.label("↻  Встряхнуть волну",14,bold=True)
        shake.setGravity(Gravity.CENTER)
        shake.setPadding(dp(18),0,dp(18),0)
        shake.setTextColor(-1)
        shake.setBackground(self.rounded(argb(0x66000000),24))
        self.click(shake,self.shake_wave,True)
        stage.addView(shake,LinearLayout.LayoutParams(WRAP,dp(48)))
        self.shake_button = shake
        settings = self.label("Изменить направление" if seed else "Обновить по коллекции" if grouped else "Настроить волну",13)
        settings.setTextColor(-1)
        settings.setGravity(Gravity.CENTER)
        if custom:
            controls=LinearLayout(self.context)
            callback=(lambda:self.choose_track_direction(seed["track"])) if seed else (lambda:self.start_collection_wave(grouped["kind"],grouped.get("playlist_id"),grouped.get("fallback","")))
            self.click(settings,callback,True)
            controls.addView(settings,LinearLayout.LayoutParams(0,dp(48),1.0))
            ordinary=self.label("Моя волна  ›",13)
            ordinary.setTextColor(-1)
            ordinary.setGravity(Gravity.CENTER)
            self.click(ordinary,self.return_to_my_wave,True)
            controls.addView(ordinary,LinearLayout.LayoutParams(0,dp(48),1.0))
            stage.addView(controls,LinearLayout.LayoutParams(MATCH,dp(48)))
        else:
            self.click(settings,lambda:self.configure_wave(False),True)
            stage.addView(settings,LinearLayout.LayoutParams(MATCH,dp(48)))
        self.content.addView(stage,LinearLayout.LayoutParams(MATCH,0,1.0))
        self.wave_label = self.padded_text(self.owner.wave_status,12)
        self.wave_label.setTextColor(-1)
        self.wave_label.setGravity(Gravity.CENTER)
        self.wave_label.setMaxLines(2)
        more = self.action_row("Дальше в волне  ›",lambda:self.show_page("wave_queue"))
        more.setTextColor(argb(0xffdfd8ff))
        more.setGravity(Gravity.CENTER)
        more.setBackgroundColor(0)

    def render_wave_queue(self):
        seed=self.owner.wave_seed
        grouped=self.owner.wave_collection
        self.page_intro("Дальше — больше",self.owner.wave_caption(),self.owner.wave_heading())
        self.padded_text(self.owner.wave_status,13,True)
        if self.owner.wave_active:
            self.action_row("Продолжить волну",self.retry_wave)
            self.action_row("Встряхнуть волну",self.shake_wave)
            self.action_row("Остановить волну",self.stop_wave)
        if seed:
            self.action_row("Изменить направление",lambda:self.choose_track_direction(seed["track"]))
            self.action_row("Вернуться к моей волне",self.return_to_my_wave)
        elif grouped:
            self.action_row("Обновить по коллекции",lambda:self.start_collection_wave(grouped["kind"],grouped.get("playlist_id"),grouped.get("fallback","")))
            self.action_row("Уточнить жанр неизвестных исполнителей",lambda:self.choose_collection_direction(grouped["kind"],grouped.get("playlist_id")))
            self.action_row("Вернуться к моей волне",self.return_to_my_wave)
        else:self.action_row("Настроить волну",lambda:self.configure_wave(False))
        if self.owner.wave_queue:
            upcoming = self.owner.wave_queue[max(0,self.owner.wave_position+1):]
            for track in upcoming:
                self.add_track_row(track,self.owner.wave_queue,wave=True)
            if not upcoming:
                self.padded_text("Следующие песни подбираются автоматически",13,True)
        else:
            self.padded_text("Здесь появятся новые песни на основе выбранной музыки." if seed or grouped else "Выбери любимых исполнителей или жанры. Лайки и прослушивания будут уточнять подбор.",14,True)
            self.action_row("Найти музыку",lambda:self.show_page("search"))

    def action_row(self,text,callback):
        view = self.label(text,15,bold=True,on=self.surface)
        view.setTextColor(self.accent)
        view.setMinHeight(dp(48))
        view.setGravity(Gravity.CENTER_VERTICAL)
        view.setPadding(dp(14),dp(8),dp(14),dp(8))
        view.setBackground(self.rounded(self.surface,16))
        self.click(view,callback,True)
        params=LinearLayout.LayoutParams(MATCH,WRAP)
        params.topMargin=dp(3);params.bottomMargin=dp(5)
        self.content.addView(view,params)
        return view

    def render_favorites(self):
        data = self.owner.collection.data
        self.page_intro("Твоя коллекция","Любимых: %d · Плейлистов: %d"%(len(data["liked"]),len(data["playlists"])),"Медиатека")
        tabs = LinearLayout(self.context)
        tabs.setPadding(dp(4),dp(4),dp(4),dp(4))
        tabs.setBackground(self.rounded(self.raised,20))
        for key,text in (("tracks","Треки"),("playlists","Плейлисты"),("cache","Кэш")):
            view = self.button(text,lambda key=key:self.set_favorite_mode(key),120,True)
            view.setTextSize(13.0)
            view.setBackground(self.rounded(self.surface if key==self.favorite_mode else 0,16))
            view.setTextColor(readable_ink(self.surface if key==self.favorite_mode else self.raised,self.accent if key==self.favorite_mode else self.muted,key!=self.favorite_mode))
            tabs.addView(view,LinearLayout.LayoutParams(0,dp(44),1.0))
        self.content.addView(tabs)
        self.padded_text("Твоя личная медиатека внутри плагина",11,True)
        if self.owner.import_status:
            self.padded_text(self.owner.import_status,13,True)
            if self.owner.import_job and not self.owner.import_job.closed:
                self.action_row("Остановить импорт",self.owner.import_job.cancel)
        if self.favorite_mode=="cache":
            self.padded_text("Кэш Telegram доступен без интернета. Очистка кэша в клиенте удалит скачанные файлы.",12,True)
            ids=list(reversed(data["cache"]))
            tracks=self.saved_tracks(ids[:self.list_limit])
            ready=[t for t in tracks if self.owner.downloads.state(t)[0]=="ready"]
            if ready:self.primary_action("▶  Слушать скачанное",lambda:self.play_collection(ids,only_cached=True))
            for track in tracks:self.add_track_row(track,tracks,collection_ids=ids)
            self.more_saved(ids)
            if not tracks:self.empty_state("Музыка с собой","Открой ⋮ у песни и выбери «Скачать в кэш»","↓")
        elif self.favorite_mode=="playlists":
            self.primary_action("＋  Создать плейлист",self.create_playlist)
            self.action_row("Как импортировать музыку из чата",self.import_help)
            for pid,playlist in data["playlists"].items():
                self.playlist_card(pid,playlist)
            if not data["playlists"]:
                self.empty_state("Для каждого настроения","Собери первый плейлист для дороги, вечера или своих людей")
        else:
            ids=list(reversed(data["liked"]))
            if ids:self.action_row("〰  Волна по всему любимому",lambda:self.start_collection_wave("liked"))
            tracks = self.saved_tracks(ids[:self.list_limit])
            if tracks:
                self.primary_action("▶  Слушать любимое",lambda:self.play_collection(ids))
                for track in tracks: self.add_track_row(track,tracks,collection_ids=ids)
                self.more_saved(ids)
            else:
                self.empty_state("Сохрани то самое","Нажми сердечко у песни, чтобы она осталась здесь","♡")
                self.action_row("Найти первый трек",lambda:self.show_page("search"))

    def playlist_card(self,pid,playlist):
        row=LinearLayout(self.context)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(10),dp(10),dp(10),dp(10))
        row.setBackground(self.rounded(self.surface,22))
        tint=argb((0xff9788d8,0xff7ba7bb,0xffb285a3,0xff86ac91)[sum(ord(c) for c in str(pid))%4])
        cover=self.heading("♫",27)
        cover.setGravity(Gravity.CENTER)
        cover.setTextColor(contrast_ink(tint))
        cover.setBackground(self.rounded(tint,17))
        cover.setImportantForAccessibility(2)
        row.addView(cover,LinearLayout.LayoutParams(dp(56),dp(56)))
        info=LinearLayout(self.context)
        info.setOrientation(1)
        info.setPadding(dp(14),0,dp(4),0)
        title=self.label(playlist["name"],17,bold=True,on=self.surface)
        title.setMaxLines(2);title.setEllipsize(TruncateAt.END)
        info.addView(title,LinearLayout.LayoutParams(MATCH,WRAP))
        subtitle=self.label("Треков: %d"%len(playlist["ids"]),12,True,on=self.surface)
        subtitle.setPadding(0,dp(6),0,0)
        info.addView(subtitle)
        row.addView(info,LinearLayout.LayoutParams(0,WRAP,1.0))
        arrow=self.label("›",24,True);arrow.setGravity(Gravity.CENTER)
        row.addView(arrow,LinearLayout.LayoutParams(dp(28),dp(48)))
        self.click(row,lambda:self.open_playlist(pid),True)
        params=LinearLayout.LayoutParams(MATCH,WRAP);params.bottomMargin=dp(8)
        self.content.addView(row,params)

    def set_favorite_mode(self,mode):
        self.favorite_mode=mode
        self.list_limit=80
        self.render()

    def more_saved(self,ids):
        if len(ids)>self.list_limit:
            def more():
                self.list_limit+=80
                self.render()
            self.action_row("Показать ещё · %d из %d"%(self.list_limit,len(ids)),more)

    def play_collection(self,ids,target_id=None,only_cached=False):
        def ready(tracks):
            if only_cached:tracks=[t for t in tracks if self.owner.downloads.state(t)[0]=="ready"]
            if not tracks:
                if not self.closed:self.notify("Сейчас нет доступных треков")
                return
            target=next((t for t in tracks if t["id"]==str(target_id)),tracks[0])
            self.owner.play(tracks,target)
        self.owner.prepare_collection(ids,ready)

    def saved_tracks(self,ids):
        result=[]
        for key in ids:
            track=self.owner.materialize(key)
            if track is None:
                stored=self.owner.collection.data["tracks"].get(str(key))
                if stored:
                    track=dict(stored)
                    track["message"]=None
            if track: result.append(track)
        return result

    def open_playlist(self,pid):
        self.playlist_id=pid
        self.show_page("playlist")

    def render_playlist(self):
        playlist=self.owner.collection.data["playlists"].get(self.playlist_id)
        if playlist is None:
            self.page="favorites"
            self.render_favorites()
            return
        self.java.getActionBar().setTitle(playlist["name"])
        ids=list(playlist["ids"])
        stored=self.owner.collection.data["tracks"]
        seconds=sum(max(0,int(stored.get(str(key),{}).get("duration",0))) for key in ids)
        hero=LinearLayout(self.context)
        hero.setOrientation(1)
        hero.setPadding(dp(20),dp(24),dp(20),dp(24))
        shade=GradientDrawable(GradientDrawable.Orientation.TL_BR,jarray(jint)([self.design["selected"],self.surface]))
        shade.setCornerRadius(float(dp(26)))
        hero.setBackground(shade)
        tag=self.label("ТВОЙ ПЛЕЙЛИСТ",10,bold=True);tag.setTextColor(self.accent)
        try:tag.setLetterSpacing(0.14)
        except Exception:pass
        hero.addView(tag)
        title=self.heading(playlist["name"],31,on=self.surface)
        title.setMaxLines(3);title.setEllipsize(TruncateAt.END)
        title.setPadding(0,dp(12),0,dp(12))
        hero.addView(title,LinearLayout.LayoutParams(MATCH,WRAP))
        hero.addView(self.label("Треков: %d · %d мин"%(len(ids),seconds//60),12,True,on=self.surface))
        self.content.addView(hero,LinearLayout.LayoutParams(MATCH,WRAP))
        if ids:
            self.primary_action("▶  Слушать плейлист",lambda:self.play_collection(ids))
            self.action_row("〰  Волна по всему плейлисту",lambda:self.start_collection_wave("playlist",self.playlist_id))
        self.action_row("Изменить плейлист",self.playlist_actions)
        self.action_row("Импорт из чата",self.import_help)
        if self.owner.import_status:
            self.padded_text(self.owner.import_status,13,True)
            if self.owner.import_job and not self.owner.import_job.closed:
                self.action_row("Остановить импорт",self.owner.import_job.cancel)
        tracks=self.saved_tracks(ids[:self.list_limit])
        if tracks:
            self.action_row("↓ Скачать плейлист в кэш",lambda:self.download_playlist(ids))
            for track in tracks:self.add_track_row(track,tracks,collection_ids=ids)
            self.more_saved(ids)
        else:
            self.empty_state("Здесь начнётся история","Добавляй песни через ⋮ рядом с треком или импортируй музыку из чата")

    def render_search(self):
        if not self.search_tracks and not self.query:
            self.page_intro("Что включим?","Найди песню, с которой хочется начать","Поиск")
        elif self.search_tracks:
            self.page_intro("Твои находки","%d треков по запросу «%s»"%(len(self.search_tracks),self.query))
        self.padded_text(self.search_status,13,True)
        if not self.search_tracks and not self.search_busy:
            names=clean_artists(self.owner.collection.data["seeds"])[:6]
            if names:
                self.padded_text("ТВОИ ОРИЕНТИРЫ",10,True,bold=True)
                for artist in names:self.action_row(artist+"  ↗",lambda artist=artist:self.quick_search(artist))
            elif not self.query:self.empty_state("Начни с любимого","Введи название песни или имя исполнителя в поиске","⌕")
        for track in self.search_tracks:self.add_track_row(track,self.search_tracks)
        if self.offset and not self.search_busy:
            self.action_row("Загрузить ещё",lambda:self.start_search(True))

    def quick_search(self,query):
        self.search_input.setText(str(query))
        self.start_search()

    def start_search(self,more=False):
        if more and self.search_busy:return
        query=str(self.search_input.getText()).strip()[:200]
        if len(query)<3:
            self.search_status="Введи минимум 3 символа"
            self.render()
            return
        if self.search_job:self.search_job.cancel()
        self.search_serial+=1
        serial=self.search_serial
        if not more or query!=self.query:
            self.search_tracks,self.offset=[],""
        self.query=query
        self.search_busy=True
        self.search_status="Ищем в глобальной музыкальной выдаче…"
        self.plugin.set_setting("last_query",query)
        AndroidUtilities.hideKeyboard(self.search_input)
        self.page="search"
        self.render()
        old_offset=self.offset
        def done(tracks,offset,error):
            if self.closed or serial!=self.search_serial:return
            self.search_busy=False
            self.search_job=None
            if error:
                self.search_status=error
            else:
                seen={track["id"] for track in self.search_tracks}
                self.search_tracks.extend(track for track in tracks if track["id"] not in seen and not seen.add(track["id"]))
                self.search_tracks=self.search_tracks[:250]
                self.offset=offset if offset!=old_offset and len(self.search_tracks)<250 else ""
                self.search_status="Глобальный поиск · %d треков"%len(self.search_tracks) if self.search_tracks else "Ничего не найдено"
            if self.page=="search":self.render()
        self.search_job=self.owner.search(query,self.offset,done)

    def add_track_row(self,track,queue,wave=False,collection_ids=None):
        row=LinearLayout(self.context)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(8),dp(8),dp(4),dp(8))
        row.setBackground(self.rounded(self.surface,19))
        def play():
            if self.toggle_selected_track(track):return
            if wave and self.owner.wave_active:
                index=next((i for i,t in enumerate(self.owner.wave_queue) if t["id"]==track["id"]),0)
                self.owner.play_wave_index(index)
            elif collection_ids is not None:self.play_collection(collection_ids,track["id"])
            else:self.play_saved(queue,track)
        play_button=self.button("▶",play,44,True)
        play_button.setTextSize(19.0)
        play_button.setTypeface(Typeface.DEFAULT)
        play_button.setTextColor(readable_ink(self.raised,self.accent))
        play_button.setBackground(self.rounded(self.raised,14))
        row.addView(play_button)
        info=LinearLayout(self.context)
        info.setOrientation(1)
        info.setPadding(dp(12),dp(3),dp(2),dp(3))
        title=self.label(track["title"],15,bold=True,on=self.surface)
        subtitle=self.label(track["artist"]+" · "+duration_text(track["duration"]),12,True,on=self.surface)
        self.cache_labels[track["id"]]=(track,subtitle)
        for label in (title,subtitle):
            label.setSingleLine(True)
            label.setEllipsize(TruncateAt.END)
            info.addView(label)
        row.addView(info,LinearLayout.LayoutParams(0,WRAP,1.0))
        heart=self.button("♥" if track["id"] in self.owner.collection.data["liked"] else "♡",lambda:self.like_track(track),38,True)
        heart.setTextColor(self.accent)
        heart.setBackgroundColor(0)
        heart.setTypeface(Typeface.DEFAULT)
        row.addView(heart)
        more=self.button("⋮",lambda:self.track_actions(track),32,True)
        more.setTypeface(Typeface.DEFAULT);more.setBackgroundColor(0)
        row.addView(more)
        self.click(info,play,True)
        self.click(row,play,True)
        params=LinearLayout.LayoutParams(MATCH,WRAP)
        params.bottomMargin=dp(6)
        self.content.addView(row,params)
        self.rows.append((track,play_button,heart))
        self.row_shells[track["id"]]=(row,title)

    def toggle_selected_track(self,track):
        media=MediaController.getInstance()
        current=media.getPlayingMessageObject()
        if current is None or int(current.currentAccount)!=self.account or not current.isMusic():return False
        document=current.getDocument()
        if document is None or str(document.id)!=str(track["id"]):return False
        if media.isMessagePaused():media.playMessage(current)
        else:media.pauseMessage(current)
        self.refresh_player()
        return True

    def play_saved(self,queue,target):
        self.owner.play(queue,target)

    def like_track(self,track):
        if track.get("message") is None:
            # A saved record already contains all metadata needed to unlike it.
            if track["id"] in self.owner.collection.data["liked"]:
                self.owner.collection.like(track["id"])
                self.owner.changed()
            return
        self.owner.toggle_like(track)

    def track_actions(self,track,allow_playlist_remove=True):
        state,percent=self.owner.downloads.state(track)
        cache_action="✓ В кэше" if state=="ready" else "↓ Загрузка %d%%"%percent if state in ("queued","loading") else "Скачать в кэш"
        options=["Добавить в плейлист","Убрать из любимого" if track["id"] in self.owner.collection.data["liked"] else "В любимое",cache_action,"Не предлагать в волне","Волна по треку"]
        if allow_playlist_remove and self.page=="playlist":options.append("Убрать из этого плейлиста")
        def chosen(dialog,index):
            if index==0:self.choose_playlist(track)
            elif index==1:self.like_track(track)
            elif index==2:
                self.download_track(track)
            elif index==3:
                self.owner.block(track)
                self.notify("Больше не будем предлагать эту песню в волне")
            elif index==4:
                self.start_track_wave(track)
            elif index==5 and allow_playlist_remove:
                playlist=self.owner.collection.data["playlists"].get(self.playlist_id)
                if playlist and track["id"] in playlist["ids"]:
                    playlist["ids"].remove(track["id"])
                    self.owner.changed()
        AlertDialogBuilder(self.context).set_title(track["title"]).set_items(options,chosen).show()

    def start_track_wave(self,track,direction=None):
        if self.closed or not self.owner.valid():return
        direction=direction or track_direction(track)
        if not direction:
            self.choose_track_direction(track)
            return
        if self.owner.start_track_wave(track,direction):self.show_page("home")

    def start_collection_wave(self,kind,playlist_id=None,fallback=""):
        if self.closed or not self.owner.valid():return
        data=self.owner.collection.data
        playlist=data["playlists"].get(playlist_id) if kind=="playlist" else None
        ids=data["liked"] if kind=="liked" else playlist["ids"] if playlist else []
        if ids and not fallback:
            stored=data["tracks"]
            members=[stored[str(key)] for key in ids if str(key) in stored]
            unknown={normalized(x) for x in ("Неизвестный исполнитель","Unknown artist","Unknown","")}
            if members and not any(normalized(name) not in unknown for track in members for name in artist_names(track.get("artist",""))):
                self.choose_collection_direction(kind,playlist_id)
                return
        if self.owner.start_collection_wave(kind,playlist_id,fallback):self.show_page("home")

    def choose_collection_direction(self,kind,playlist_id=None):
        parents=list(GENRES)
        def selected(dialog,index):
            if self.closed or not self.owner.valid() or not 0<=index<len(parents):return
            self.start_collection_wave(kind,playlist_id,parents[index])
        AlertDialogBuilder(self.context).set_title("Направление коллекции").set_message("Выбери жанр для записей, направление которых не удалось определить.").set_items(parents,selected).set_negative_button("Отмена").show()

    def choose_track_direction(self,track):
        parents=list(GENRES)
        def selected_parent(dialog,index):
            if self.closed or not self.owner.valid() or not 0<=index<len(parents):return
            parent=parents[index]
            children=list(SUBGENRES.get(parent,{}))
            def selected_child(child_dialog,child_index):
                if self.closed or not self.owner.valid() or not 0<=child_index<=len(children):return
                direction=parent if child_index==0 else subgenre_key(parent,children[child_index-1])
                self.start_track_wave(track,direction)
            AlertDialogBuilder(self.context).set_title(parent).set_items(["Весь жанр"]+children,selected_child).set_negative_button("Отмена").show()
        AlertDialogBuilder(self.context).set_title("Направление волны").set_message("Выбери жанр исходной песни. Подбор работает по исполнителям и направлениям, без анализа звучания.").set_items(parents,selected_parent).set_negative_button("Отмена").show()

    def return_to_my_wave(self):
        self.owner.stop_wave()
        self.owner.wave_status="Нажми, чтобы включить свою музыку"
        if self.owner.collection.sources():
            self.owner.start_wave()
            self.show_page("home")
        else:
            self.page="home"
            self.configure_wave(True)

    def download_track(self,track):
        state,percent=self.owner.downloads.state(track)
        if state=="ready":
            self.owner.downloads.enqueue([track])
            self.notify("Песня уже в кэше Telegram")
        elif state in ("queued","loading"):
            self.owner.downloads.enqueue([track])
            self.notify("Песня уже загружается")
        else:
            self.owner.downloads.enqueue([track])
            self.notify("Скачиваем в кэш Telegram")

    def download_playlist(self,ids):
        def accept(dialog,which):
            def ready(tracks):
                count=self.owner.downloads.enqueue(tracks)
                if not self.closed:self.notify("Добавлено в очередь скачивания: %d"%count)
            self.owner.prepare_collection(ids,ready,for_playback=False)
        AlertDialogBuilder(self.context).set_title("Скачать плейлист?").set_message("Треков: %d. Файлы займут место в кэше Telegram."%len(ids)).set_positive_button("Скачать",accept).set_negative_button("Отмена").show()

    def import_help(self):
        AlertDialogBuilder(self.context).set_title("Импорт из Telegram").set_message("Открой чат с музыкой → ⋮ → «Импорт музыки в Ayu Music». Выбери этот плейлист и объём импорта.\n\nДля одной песни или аудиоальбома: удерживай аудиосообщение → «В плейлист Ayu Music». Если клиент передаёт выделенные сообщения, они импортируются вместе.\n\nПереносятся записи о песнях. Скачивание в кэш запускается отдельно.").set_positive_button("Понятно").show()

    def choose_playlist(self,track):
        ids=list(self.owner.collection.data["playlists"])
        labels=[self.owner.collection.data["playlists"][pid]["name"] for pid in ids]+["＋ Новый плейлист"]
        def chosen(dialog,index):
            if index==len(ids):self.create_playlist(track)
            else:
                if track.get("message") is not None:self.owner.add_to_playlist(ids[index],track)
                else:
                    self.owner.collection.add(ids[index],track["id"])
                    self.owner.changed()
                self.notify("Добавлено в плейлист плагина")
        AlertDialogBuilder(self.context).set_title("Добавить в плейлист").set_items(labels,chosen).show()

    def text_dialog(self,title,initial,callback,hint=""):
        edit=EditText(self.context)
        edit.setTextColor(readable_ink(self.surface,self.foreground))
        edit.setHintTextColor(readable_ink(self.surface,self.muted,True))
        edit.setSingleLine(True)
        edit.setText(str(initial))
        edit.setHint(hint)
        edit.setPadding(dp(18),dp(12),dp(18),dp(12))
        edit.setTypeface(self.fonts["body"])
        edit.setBackground(self.rounded(self.surface,16))
        def accept(dialog,which):
            value=str(edit.getText()).strip()
            if value:callback(value)
        AlertDialogBuilder(self.context).set_title(title).set_view(edit).set_positive_button("Сохранить",accept).set_negative_button("Отмена").show()

    def create_playlist(self,track=None):
        def create(name):
            pid=self.owner.collection.playlist(name)
            if track:
                if track.get("message") is not None:self.owner.keep(track)
                self.owner.collection.add(pid,track["id"])
            self.owner.changed()
            self.notify("Плейлист создан")
        self.text_dialog("Новый плейлист","",create,"Название")

    def playlist_actions(self):
        pid=self.playlist_id
        playlist=self.owner.collection.data["playlists"].get(pid)
        if not playlist:return
        def choose(dialog,index):
            if index==0:
                def rename(name):
                    playlist["name"]=name[:80]
                    self.owner.changed()
                self.text_dialog("Название плейлиста",playlist["name"],rename)
            else:
                def delete(dialog,which):
                    self.owner.collection.data["playlists"].pop(pid,None)
                    self.page="favorites"
                    self.owner.changed()
                AlertDialogBuilder(self.context).set_title("Удалить плейлист?").set_message("Любимые песни останутся в коллекции.").set_positive_button("Удалить",delete).set_negative_button("Отмена").show()
        AlertDialogBuilder(self.context).set_title(playlist["name"]).set_items(["Переименовать","Удалить плейлист"],choose).show()

    def configure_wave(self,start_after=False):
        self.wave_return=self.page if self.page not in ("wave_settings","artists") else self.wave_return
        self.wave_draft=WaveDraft(self.owner.collection)
        self.start_after_settings=bool(start_after)
        self.show_page("wave_settings")

    def render_wave_settings(self):
        if self.wave_draft is None:self.wave_draft=WaveDraft(self.owner.collection)
        draft=self.wave_draft
        self.page_intro("Под твой вкус","Исполнители задают направление. Волна найдёт и новые имена.","Настройка волны")
        self.padded_text("Любимые исполнители",18,bold=True)
        summary=", ".join(draft.artists[:4])
        if len(draft.artists)>4:summary+=" · ещё %d"%(len(draft.artists)-4)
        self.padded_text(summary or "Начни с нескольких любимых имён",13,True)
        self.action_row("Выбрать исполнителей  ›",self.open_artist_picker)
        self.padded_text("Жанры и поджанры",18,bold=True)
        self.padded_text("Раскрой жанр, чтобы выбрать направления. Галочка слева выбирает весь жанр.",12,True)
        tree=GenreTree(self,draft)
        self.genre_tree=tree
        self.content.addView(tree.view,LinearLayout.LayoutParams(MATCH,WRAP))
        self.padded_text("Направления помогают подбору: жанр каждой песни Telegram не сообщает.",11,True)
        short=self.action_row(("✓  " if draft.hide_short else "□  ")+"Скрывать короткие отрывки",lambda:None)
        def toggle_short():
            draft.hide_short=not draft.hide_short
            short.setText(("✓  " if draft.hide_short else "□  ")+"Скрывать короткие отрывки")
        self.click(short,toggle_short,True)
        self.padded_text("Короче 45 секунд",11,True)

    def open_artist_picker(self):
        if self.wave_draft is None:return
        self.show_page("artists")

    def render_artists(self):
        if self.wave_draft is None:self.wave_draft=WaveDraft(self.owner.collection)
        if self.artist_picker is None:
            picker=ArtistPicker(self,self.wave_draft.artists)
            self.artist_picker=picker
            self.preference_editors.append(picker)
            self.editor_host.removeAllViews()
            self.editor_host.addView(picker.view,LinearLayout.LayoutParams(MATCH,MATCH))
        # Playback updates must not rebuild this view or replace the focused field.

    def close_artist_picker(self):
        if self.artist_picker is None:return
        picker=self.artist_picker
        self.artist_picker=None
        AndroidUtilities.hideKeyboard(picker.edit)
        picker.close()
        if picker in self.preference_editors:self.preference_editors.remove(picker)
        self.editor_host.removeAllViews()

    def commit_edit(self):
        if self.page=="artists":
            if self.artist_picker and self.wave_draft:
                self.wave_draft.artists=clean_artists(self.artist_picker.selected)
            self.show_page("wave_settings")
        elif self.page=="wave_settings":
            draft=self.wave_draft
            start_after=self.start_after_settings
            target=self.wave_return
            self.wave_draft=None
            if draft is not None:draft.apply(self.owner.collection)
            self.show_page(target)
            if draft is not None:
                self.owner.settings_changed()
                if start_after:self.owner.start_wave()
        elif self.page=="appearance":
            self.show_page(self.appearance_return)

    def cancel_edit(self):
        if self.page=="artists":self.show_page("wave_settings")
        elif self.page=="wave_settings":
            self.wave_draft=None
            self.show_page(self.wave_return)
        elif self.page=="appearance":self.show_page(self.appearance_return)

    def open_appearance(self):
        if self.page=="appearance":return
        self.appearance_return=self.page
        self.show_page("appearance")

    def set_appearance(self,key,value):
        if key not in ("design_theme","design_font"):return
        allowed=MUSIC_THEMES if key=="design_theme" else MUSIC_FONTS
        if value not in allowed and not (key=="design_theme" and value=="auto"):return
        self.plugin.set_setting(key,value)
        for screen in list(getattr(self.plugin,"screens",[])):
            if screen is not self and not screen.closed and screen.page not in ("artists","wave_settings"):
                screen.render()
        self.render()

    def render_appearance(self):
        self.appearance_serial+=1
        self.page_intro("Твоё настроение","Цвет и типографика для всех экранов Ayu Music","Облик")
        self.padded_text("Оформление",18,bold=True)
        active=self.plugin.get_setting("design_theme","auto")
        options=[("auto","Как в Telegram","Автоматически светлая или тёмная тема")]+[(key,item["name"],item["description"]) for key,item in MUSIC_THEMES.items()]
        for key,title,description in options:
            swatch=screen_design(key,"appearance",color("key_windowBackgroundGray",-15724528))
            row=LinearLayout(self.context)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(12),dp(12),dp(12),dp(12))
            row.setBackground(self.rounded(self.design["selected"] if key==active else self.surface,20))
            sample=LinearLayout(self.context)
            sample.setOrientation(1)
            sample.setGravity(Gravity.CENTER)
            sample.setPadding(dp(8),dp(8),dp(8),dp(8))
            sample.setBackground(self.rounded(swatch["background"],12))
            for tint in (swatch["accent"],swatch["surface"]):
                stripe=View(self.context)
                stripe.setBackground(self.rounded(tint,4))
                sp=LinearLayout.LayoutParams(MATCH,dp(9));sp.bottomMargin=dp(5)
                sample.addView(stripe,sp)
            row.addView(sample,LinearLayout.LayoutParams(dp(48),dp(48)))
            details=LinearLayout(self.context);details.setOrientation(1)
            details.setPadding(dp(14),0,dp(8),0)
            details.addView(self.label(title,16,bold=True,on=self.surface))
            desc=self.label(description,12,True,on=self.surface);desc.setPadding(0,dp(5),0,0)
            details.addView(desc,LinearLayout.LayoutParams(MATCH,WRAP))
            row.addView(details,LinearLayout.LayoutParams(0,WRAP,1.0))
            mark=self.label("✓" if key==active else "",20)
            mark.setTextColor(self.accent);mark.setGravity(Gravity.CENTER)
            row.addView(mark,LinearLayout.LayoutParams(dp(28),dp(42)))
            self.click(row,lambda key=key:self.set_appearance("design_theme",key),True)
            params=LinearLayout.LayoutParams(MATCH,WRAP);params.bottomMargin=dp(8)
            self.content.addView(row,params)
        self.padded_text("Шрифт",18,bold=True)
        keys=list(MUSIC_FONTS)
        selected=self.plugin.get_setting("design_font","rounded")
        spinner=jclass("android.widget.Spinner")(self.context,1)
        self.font_adapter=FontListAdapter.new_instance(init_args=[self,keys])
        spinner.setAdapter(self.font_adapter.java)
        try:spinner.setPopupBackgroundDrawable(self.rounded(self.surface,18))
        except Exception:pass
        spinner.setSelection(keys.index(selected) if selected in keys else 0)
        self.font_listener=FontSelectionListener(self,keys,self.appearance_serial)
        spinner.setOnItemSelectedListener(self.font_listener)
        self.content.addView(spinner,LinearLayout.LayoutParams(MATCH,dp(56)))
        sample=self.heading("Твоя музыка — твой стиль",23)
        sample.setPadding(dp(6),dp(14),dp(6),dp(4))
        self.content.addView(sample,LinearLayout.LayoutParams(MATCH,WRAP))
        self.padded_text("АБВГД · абвгд · ABCD · 0123456789",14)
        self.padded_text("Начертания системные; их вид может отличаться на разных устройствах.",11,True)
        self.padded_text("Свои цвета",18,bold=True)
        self.color_row("all","Общий цвет оформления")
        self.padded_text("Общий цвет задаёт палитру. Ниже можно отдельно настроить каждый элемент. Контраст подписей подбирается автоматически.",12,True)
        self.action_row(("⌃" if self.colors_expanded else "⌄")+"  Цвета отдельных блоков",self.toggle_color_parts)
        if self.colors_expanded:
            for key,title in COLOR_PARTS.items():self.color_row(key,title)
        self.padded_text("Фон волны по жанру",18,bold=True)
        self.padded_text("Поджанры наследуют цвет родителя. Если направление неизвестно — серые переливы.",12,True)
        for parent in GENRE_COLORS:self.color_row("genre:"+parent,parent)
        self.action_row("Сбросить мои цвета",self.reset_colors)

    def toggle_color_parts(self):
        self.colors_expanded=not self.colors_expanded
        self.render()

    def color_value(self,key):
        custom=custom_colors(self.plugin.get_setting("design_colors",None))
        if key=="all":return parse_color(custom.get("all")) or self.design["buttons"]
        if key.startswith("genre:"):
            parent=key[6:]
            return parse_color(custom["genres"].get(parent)) or argb(GENRE_COLORS[parent])
        return self.design.get(key,self.surface)

    def color_row(self,key,title):
        view=self.action_row(title+"  ›",lambda:self.open_color_editor(key,title))
        drawable=self.rounded(self.color_value(key),7)
        drawable.setBounds(0,0,dp(24),dp(24))
        try:drawable.setStroke(dp(1),readable_ink(self.surface,self.muted,True))
        except Exception:pass
        view.setCompoundDrawables(drawable,None,None,None)
        view.setCompoundDrawablePadding(dp(12))

    def open_color_editor(self,key,title):
        editor=ColorEditor(self,self.color_value(key))
        self.color_editors.append(editor)
        scroll=ScrollView(self.context)
        scroll.addView(editor.view,ScrollView.LayoutParams(MATCH,WRAP))
        def apply(dialog,which):
            if editor.valid:self.set_custom_color(key,editor.value)
        def reset(dialog,which):self.set_custom_color(key,None)
        def dismissed(dialog):
            editor.close()
            AndroidUtilities.hideKeyboard(editor.hex)
            if editor in self.color_editors:self.color_editors.remove(editor)
        builder=AlertDialogBuilder(self.context).set_title(title).set_view(scroll,dp(420))
        builder.set_positive_button("Применить",apply).set_negative_button("Отмена")
        builder.set_neutral_button("По умолчанию",reset).set_on_dismiss_listener(dismissed)
        editor.builder=builder
        builder.show()

    def set_custom_color(self,key,value):
        data=custom_colors(self.plugin.get_setting("design_colors",None))
        normalized_value=parse_color(value)
        if value is not None and normalized_value is None:return
        if key=="all":
            if value is None:data.pop("all",None)
            else:data["all"]=color_hex(normalized_value)
        else:
            group="genres" if key.startswith("genre:") else "parts"
            name=key[6:] if group=="genres" else key
            allowed=GENRE_COLORS if group=="genres" else COLOR_PARTS
            if name not in allowed:return
            if value is None:data[group].pop(name,None)
            else:data[group][name]=color_hex(normalized_value)
        self.plugin.set_setting("design_colors",json.dumps(data,ensure_ascii=False))
        self.refresh_design_screens()

    def reset_colors(self):
        self.plugin.set_setting("design_colors",json.dumps({"parts":{},"genres":{}}))
        self.refresh_design_screens()

    def refresh_design_screens(self):
        for screen in list(getattr(self.plugin,"screens",[])):
            if screen is not self and not screen.closed and screen.page not in ("artists","wave_settings"):screen.render()
        self.render()

    def wave_click(self):
        if self.owner.seed_starting:return
        if self.owner.wave_active:
            current=MediaController.getInstance().getPlayingMessageObject()
            if self.owner.is_wave_message(current):self.toggle_play()
            elif not self.owner.wave_busy:self.retry_wave()
            return
        if self.owner.wave_seed:
            self.start_track_wave(self.owner.wave_seed["track"],self.owner.wave_seed["direction"])
            return
        if self.owner.wave_collection:
            self.owner.restart_wave()
            return
        if not self.owner.collection.sources():self.configure_wave(True)
        else:self.owner.start_wave()

    def retry_wave(self):
        self.owner.attempts,self.owner.failures=0,0
        if not self.owner.wave_active:self.owner.restart_wave()
        else:self.owner.fill_wave()

    def shake_wave(self):
        if not self.owner.wave_sources():
            self.configure_wave(True)
            return
        self.owner.shake_wave()
        self.refresh_player()

    def stop_wave(self):
        current=MediaController.getInstance().getPlayingMessageObject()
        if self.owner.is_wave_message(current):MediaController.getInstance().pauseMessage(current)
        self.owner.stop_wave(keep_seed=True)
        self.owner.wave_status="Волна остановлена"
        self.render()

    def like_playing(self):
        track=self.owner.playing_track()
        if track:self.like_track(track)

    def playing_actions(self):
        track=self.owner.playing_track()
        if track:self.track_actions(track,allow_playlist_remove=False)
        else:self.notify("Для текущей аудиозаписи действия недоступны")

    def toggle_play(self):
        media=MediaController.getInstance()
        current=media.getPlayingMessageObject()
        if current is None:
            self.wave_click()
            return
        if int(current.currentAccount)!=self.account or not current.isMusic():return
        if media.isMessagePaused():media.playMessage(current)
        else:media.pauseMessage(current)
        self.refresh_player()

    def next_track(self):
        media=MediaController.getInstance()
        current=media.getPlayingMessageObject()
        if current is not None and int(current.currentAccount)==self.account and current.isMusic():media.playNextMessage()

    def show_player(self):
        current=MediaController.getInstance().getPlayingMessageObject()
        if current is None or int(current.currentAccount)!=self.account or not current.isMusic():
            self.notify("Сначала запусти трек")
            return
        self.java.showDialog(AudioPlayerAlert(self.context,self.java.getResourceProvider()))

    def update_player(self):
        if self.closed or not self.visible or not self.plugin.active:return
        try:self.refresh_player()
        except Exception:pass
        self.root.postDelayed(self.ticker,900)

    def refresh_player(self):
        if not hasattr(self,"player_title"):return
        media=MediaController.getInstance()
        current=media.getPlayingMessageObject()
        own=self.owner.owned_track(current)
        valid=current is not None and int(current.currentAccount)==self.account and current.isMusic()
        if not valid:
            self.player_title.setText("Выбери трек")
            self.player_subtitle.setText("Включи волну или найди песню")
            self.play_button.setText("▶")
        else:
            self.player_title.setText(str(current.getMusicTitle()))
            self.player_subtitle.setText(str(current.getMusicAuthor())+" · "+("Загрузка…" if media.isDownloadingCurrentMessage() else duration_text(current.audioProgressSec)))
            self.play_button.setText("▶" if media.isMessagePaused() else "Ⅱ")
        liked=self.owner.collection.data["liked"]
        current_id=str(current.getDocument().id) if valid and current.getDocument() is not None else ""
        self.player_heart.setText("♥" if current_id in liked else "♡")
        self.player_heart.setTextColor(readable_ink(self.player_fill,self.accent if own else self.muted,not bool(own)))
        self.player_heart.setEnabled(valid)
        self.player_more.setEnabled(valid)
        self.player_more.setAlpha(1.0 if valid else 0.4)
        if self.wave_symbol is not None:
            self.wave_symbol.setText("Ⅱ" if valid and self.owner.wave_active and self.owner.is_wave_message(current) and not media.isMessagePaused() else "▶")
        for track,play,heart in self.rows:
            active=bool(valid and str(current.getDocument().id)==str(track["id"]))
            play.setText("Ⅱ" if active and not media.isMessagePaused() else "▶")
            heart.setText("♥" if track["id"] in liked else "♡")
            if self.row_states.get(track["id"])!=active:
                self.row_states[track["id"]]=active
                shell=self.row_shells.get(track["id"])
                if shell:
                    row,title=shell
                    fill=self.design["selected"] if active else self.surface
                    row.setBackground(self.rounded(fill,19))
                    title.setTextColor(readable_ink(fill,self.accent if active else self.foreground))
                    subtitle=self.cache_labels.get(track["id"])
                    if subtitle:subtitle[1].setTextColor(readable_ink(fill,self.muted,True))
        for track,subtitle in self.cache_labels.values():
            state,percent=self.owner.downloads.state(track)
            tail={"ready":" · ✓ кэш","queued":" · в очереди","loading":" · ↓ %d%%"%percent,"failed":" · ошибка загрузки"}.get(state,"")
            if state=="missing" and track["id"] in self.owner.collection.data["cache"]:tail=" · нет файла в кэше"
            subtitle.setText(track["artist"]+" · "+duration_text(track["duration"])+tail)
        if self.wave_label is not None:self.wave_label.setText(self.owner.wave_status)
        if self.shake_button is not None:
            busy=self.owner.wave_rebuilding or self.owner.seed_starting
            self.shake_button.setText("Готовим исходную песню…" if self.owner.seed_starting else "Подбираем новые песни…" if self.owner.wave_rebuilding else "↻  Встряхнуть волну")
            self.shake_button.setEnabled(not busy)
            self.shake_button.setAlpha(0.65 if busy else 1.0)
        if self.backdrop:self.backdrop.update(current)


class AyuMusicPlugin(BasePlugin):
    def on_plugin_load(self):
        self.active = True
        self.screens, self.header_buttons, self.accounts = [], [], {}
        self.last_error = ""
        self.message_id = -random.randint(1200000000,1600000000)
        self.render_pending = set()
        self.observer = PlaybackObserver(self)
        self.observed_accounts = set()
        self.events = [NotificationCenter.messagePlayingDidStart,NotificationCenter.messagePlayingPlayStateChanged,
            NotificationCenter.messagePlayingProgressDidChanged,NotificationCenter.messagePlayingDidReset]
        self.cache_events=[NotificationCenter.fileLoaded,NotificationCenter.fileLoadFailed,NotificationCenter.fileLoadProgressChanged]
        self.events.extend(self.cache_events)
        dialogs = find_class("org.telegram.ui.DialogsActivity")
        if dialogs is not None:
            self.hook_all_methods(dialogs,"createView",HeaderHook(self))
            self.hook_all_methods(dialogs,"onResume",HeaderHook(self))
        media = find_class("org.telegram.messenger.MediaController")
        self.wave_available = False
        if media is not None:
            hooks = self.hook_all_methods(media,"playNextMessageWithoutOrder",WaveSkipHook(self))
            self.wave_available = bool(hooks)
            self.hook_all_methods(media,"playPreviousMessage",WaveSkipHook(self,True))
        for menu_type in (MenuItemType.DRAWER_MENU,MenuItemType.MAIN_MENU):
            try:
                self.add_menu_item(MenuItemData(menu_type=menu_type,text="Музыка",icon="msg_filled_data_music",on_click=lambda context:self.open_music()))
            except Exception:
                pass
        try:
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,text="В плейлист Ayu Music",icon="msg_filled_data_music",
                condition="message != null && message.isMusic()",on_click=self.import_message_menu))
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU,text="Импорт музыки в Ayu Music",icon="msg_filled_data_music",
                on_click=self.import_chat_menu))
        except Exception:self.record_error("register import menus")
        run_on_ui_thread(self.attach_existing,300)

    def on_plugin_unload(self):
        self.active = False
        def cleanup():
            for screen in list(self.screens):screen.dispose()
            for owner in self.accounts.values():owner.dispose()
            for account in self.observed_accounts:
                for event in self.events:
                    try:NotificationCenter.getInstance(account).removeObserver(self.observer,event)
                    except Exception:pass
            for menu,item,listener in self.header_buttons:
                try:
                    item.setOnClickListener(None)
                    menu.removeView(item)
                except Exception:pass
            self.header_buttons.clear()
        run_on_ui_thread(cleanup)

    def record_error(self,where):
        self.last_error = where+"\n"+traceback.format_exc()
        self.log(self.last_error)

    def next_message_id(self):
        self.message_id -= 1
        return self.message_id

    def music_account(self,account):
        account=int(account)
        user_id=int(UserConfig.getInstance(account).getClientUserId())
        owner=self.accounts.get(account)
        if owner is None or owner.user_id!=user_id:
            if owner:owner.dispose()
            owner=MusicAccount(self,account)
            self.accounts[account]=owner
        if account not in self.observed_accounts:
            for event in self.events:NotificationCenter.getInstance(account).addObserver(self.observer,event)
            self.observed_accounts.add(account)
        return owner

    def update_screens(self,owner):
        if not self.active or owner.account in self.render_pending:return
        self.render_pending.add(owner.account)
        def update():
            self.render_pending.discard(owner.account)
            for screen in list(self.screens):
                if screen.owner is owner and not screen.closed:
                    try:
                        if screen.page in ("appearance","wave_settings","artists"):screen.refresh_player()
                        else:screen.render()
                    except Exception:self.record_error("refresh screen")
        run_on_ui_thread(update,80)

    def attach_existing(self):
        if not self.active:return
        try:
            fragment=get_last_fragment()
            if fragment is not None and str(fragment.getClass().getName())=="org.telegram.ui.DialogsActivity":self.attach_button(fragment)
        except Exception:self.record_error("attach existing")

    def attach_button(self,fragment):
        if not self.active or bool(field(fragment,"onlySelect")):return
        bar=fragment.getActionBar()
        if bar is None:return
        menu=bar.createMenu()
        if menu.getItem(BUTTON_ID) is not None:return
        context=fragment.getParentActivity()
        if context is None:return
        icon=resource(context,"msg_filled_data_music","search_music_filled","files_music")
        item=menu.addItemWithWidth(BUTTON_ID,icon,dp(48)) if icon else menu.addItem(BUTTON_ID,"♫")
        item.setContentDescription("Музыка · Ayu Music")
        listener=OnClickListener(lambda view:self.open_music(fragment))
        item.setOnClickListener(listener)
        params=item.getLayoutParams()
        menu.removeView(item)
        menu.addView(item,0,params)
        self.header_buttons.append((menu,item,listener))

    def open_music(self,source=None,page="home"):
        if not self.active:return
        def open_screen():
            try:
                fragment=source if source is not None else get_last_fragment()
                if fragment is None or fragment.getParentActivity() is None:return
                screen=MusicScreen.new_instance(init_args=[self,int(fragment.getCurrentAccount())])
                if page=="appearance":screen.page="appearance"
                screen.java.setCurrentAccount(int(fragment.getCurrentAccount()))
                self.screens.append(screen)
                if not fragment.presentFragment(screen.java):screen.dispose()
            except Exception:
                self.record_error("open")
                self.show_diagnostics()
        run_on_ui_thread(open_screen)

    def current_context(self):
        fragment=get_last_fragment()
        return fragment.getParentActivity() if fragment is not None else None

    def music_notice(self,owner,message):
        self.last_error=str(message)
        context=self.current_context()
        if context is not None and owner.valid():Toast.makeText(context,str(message),Toast.LENGTH_LONG).show()

    def current_owner(self):
        fragment=get_last_fragment()
        return self.music_account(int(fragment.getCurrentAccount())) if fragment is not None else None

    def show_diagnostics(self):
        context=self.current_context()
        if context is None:return
        text="Ayu Music 1.2.0\nАвтор: @Demon_In_Moscow\nAyuGram 20261104 / exteraGram 13.1.1\n"
        text+="Кнопок: %d · обработчик волны: %s\n"%(len(self.header_buttons),"готов" if self.wave_available else "недоступен")
        owner=self.current_owner()
        if owner:
            text+="Любимое: %d · плейлисты: %d\n"%(len(owner.collection.data["liked"]),len(owner.collection.data["playlists"]))
            text+="Волна: %s · очередь: %d\n"%(owner.wave_active,len(owner.wave_queue))
            text+="Автопереходы: Telegram %d · волна %d\n"%(owner.native_transitions,owner.python_transitions)
            text+="Последний переход: "+owner.last_transition+"\n"
            if owner.wave_seed:text+="Исходный трек: "+owner.wave_seed["track"]["title"]+" — "+owner.wave_seed["track"]["artist"]+"\nНаправление: "+owner.wave_seed["direction"]+"\n"
            if owner.wave_collection:text+="Коллекция: "+owner.wave_collection["name"]+" · треков: %d\n"%owner.wave_collection["profile"]["count"]
            text+=owner.wave_status+"\n"
            text+="Кэш: %d · загрузок: %d\n"%(len(owner.collection.data["cache"]),len(owner.downloads.active))
            if owner.import_status:text+=owner.import_status+"\n"
        text+="\n"+(self.last_error or "Ошибок плагина пока не записано.")
        AlertDialogBuilder(context).set_title("Диагностика Ayu Music").set_message(text).set_positive_button("Закрыть").set_neutral_button("Скопировать",lambda dialog,which:copy_to_clipboard(text)).show()

    def export_collection(self):
        owner=self.current_owner()
        if owner is None:return
        payload=json.dumps({"ayu_music_backup":2,"collection":owner.collection.data},ensure_ascii=False,separators=(",",":"))
        if len(payload.encode("utf-8"))>400000:
            AlertDialogBuilder(self.current_context()).set_title("Большая коллекция").set_message("Коллекция превышает безопасный размер буфера обмена. Копия не создана.").set_positive_button("Закрыть").show()
            return
        copy_to_clipboard(payload)

    def import_collection(self):
        owner=self.current_owner()
        context=self.current_context()
        if owner is None or context is None:return
        try:
            clipboard=context.getSystemService("clipboard")
            clip=clipboard.getPrimaryClip()
            if clip is None or clip.getItemCount()==0:raise ValueError("Сначала скопируй резервную копию")
            text=str(clip.getItemAt(0).coerceToText(context))
            if len(text.encode("utf-8"))>2000000:raise ValueError("Слишком большая резервная копия")
            payload=json.loads(text)
            if not isinstance(payload,dict) or payload.get("ayu_music_backup")!=2:raise ValueError("В буфере нет резервной копии Ayu Music")
            restored=Collection(payload["collection"])
        except Exception as error:
            AlertDialogBuilder(context).set_title("Не удалось импортировать").set_message(str(error)).set_positive_button("Закрыть").show()
            return
        def replace(dialog,which):
            owner.stop_wave()
            if owner.import_job:owner.import_job.cancel()
            owner.downloads.dispose()
            for job in list(owner.jobs):job.cancel()
            owner.collection=restored
            owner.runtime.clear();owner.owned.clear();owner.local_queue=[]
            owner.downloads=CacheDownloads(owner)
            owner.save(immediate=True)
            self.update_screens(owner)
        message="В копии: %d любимых песен и %d плейлистов. Заменить текущую коллекцию плагина?"%(len(restored.data["liked"]),len(restored.data["playlists"]))
        AlertDialogBuilder(context).set_title("Импорт коллекции").set_message(message).set_positive_button("Заменить",replace).set_negative_button("Отмена").show()

    def clear_blocked(self):
        owner=self.current_owner()
        if owner:
            owner.collection.data["blocked"]=[]
            owner.changed()

    def import_context(self,context):
        fragment=context.get("fragment") or get_last_fragment()
        if fragment is None:return None,None,None
        account=context.get("account")
        if account is None:account=fragment.getCurrentAccount()
        return self.music_account(int(account)),fragment,fragment.getParentActivity()

    def pick_import_playlist(self,owner,context,callback):
        ids=list(owner.collection.data["playlists"])
        labels=[owner.collection.data["playlists"][pid]["name"] for pid in ids]+["＋ Новый плейлист"]
        def selected(dialog,index):
            if index<len(ids):callback(ids[index])
            else:
                edit=EditText(context)
                edit.setTextColor(color("key_windowBackgroundWhiteBlackText",-1))
                edit.setHint("Название плейлиста")
                edit.setSingleLine(True)
                edit.setPadding(dp(18),dp(12),dp(18),dp(12))
                def create(dialog,which):
                    name=str(edit.getText()).strip()
                    if not name:return
                    pid=owner.collection.playlist(name)
                    owner.changed()
                    callback(pid)
                AlertDialogBuilder(context).set_title("Новый плейлист").set_view(edit).set_positive_button("Создать",create).set_negative_button("Отмена").show()
        AlertDialogBuilder(context).set_title("Импортировать в плейлист").set_items(labels,selected).show()

    def import_message_menu(self,context):
        run_on_ui_thread(lambda:self.import_from_menu(context,False))

    def import_chat_menu(self,context):
        run_on_ui_thread(lambda:self.import_from_menu(context,True))

    def import_from_menu(self,context,whole_chat):
        try:
            owner,fragment,activity=self.import_context(context)
            if owner is None or activity is None or not owner.valid():return
            messages=import_selection(context,fragment)
            if messages:
                messages=[m for m in messages if int(m.currentAccount)==owner.account]
                if not messages:return
                def destination(pid):
                    def perform(dialog,which):
                        count=owner.import_messages(pid,messages)
                        owner.import_status="Из сообщений добавлено: %d треков"%count
                        owner.changed()
                        Toast.makeText(activity,owner.import_status,Toast.LENGTH_LONG).show()
                    AlertDialogBuilder(activity).set_title("Добавить музыку?").set_message("Аудиозаписей: %d. Файлы автоматически скачиваться не будут."%len(messages)).set_positive_button("Добавить",perform).set_negative_button("Отмена").show()
                self.pick_import_playlist(owner,activity,destination)
                return
            if not whole_chat:
                Toast.makeText(activity,"Выбери аудиозапись или альбом",Toast.LENGTH_LONG).show()
                return
            if owner.import_job and not owner.import_job.closed:
                Toast.makeText(activity,"Импорт уже идёт. Его можно остановить в разделе «Медиатека».",Toast.LENGTH_LONG).show()
                return
            dialog_id=int(context.get("dialog_id") or fragment.getDialogId())
            if dialog_id==0:return
            # Secret chat IDs are not cloud peers; never send an empty-peer query
            # that could unexpectedly search outside the requested conversation.
            if dialog_id>0 and (dialog_id & 0xffffffff)==0:
                Toast.makeText(activity,"Импорт целого секретного чата не поддерживается",Toast.LENGTH_LONG).show()
                return
            try:topic_id=int(fragment.getTopicId())
            except Exception:topic_id=0
            def destination(pid):
                def scope(dialog,index):
                    limit=[100,500,0][index]
                    job=ChatImport(owner,pid,dialog_id,topic_id,limit)
                    job.start()
                    Toast.makeText(activity,"Импорт начат. Прогресс — в разделе «Медиатека».",Toast.LENGTH_LONG).show()
                AlertDialogBuilder(activity).set_title("Какую музыку перенести?").set_message("Из открытой темы" if topic_id else "Из этого чата").set_items(["Последние 100 аудиозаписей","Последние 500 аудиозаписей","Всю музыку (до 10 000 записей)"],scope).show()
            self.pick_import_playlist(owner,activity,destination)
        except Exception:
            self.record_error("import from chat")
            self.show_diagnostics()

    def create_settings(self):
        return [Header(text="Ayu Music · 1.2.0"),
            Text(text="Открыть музыку",icon="msg_filled_data_music",on_click=lambda view:self.open_music()),
            Text(text="Облик, цвета и шрифты",subtext="Общая палитра, цвета блоков и жанров, 13 начертаний",icon="msg_theme",on_click=lambda view:self.open_music(page="appearance")),
            Text(text="Диагностика",icon="msg_info",on_click=lambda view:self.show_diagnostics()),
            Divider(text="⋮ в мини-плеере — действия с текущей песней. Волны по плейлисту и всему любимому — в Медиатеке. Поиск и Медиатека — в нижнем островке. Облик и шрифты — значок вверху."),
            Divider(text="Скачивание: ⋮ у песни → «Скачать в кэш». Импорт: ⋮ в чате → «Импорт музыки в Ayu Music» или меню аудиосообщения → «В плейлист Ayu Music»."),
            Header(text="Коллекция"),
            Text(text="Скопировать резервную копию",subtext="Лайки, плейлисты и интересы в буфер обмена",icon="msg_copy",on_click=lambda view:self.export_collection()),
            Text(text="Импортировать из буфера",subtext="Потребуется подтвердить замену коллекции",icon="msg_input",on_click=lambda view:self.import_collection()),
            Text(text="Снова предлагать скрытые треки",icon="msg_reset",on_click=lambda view:self.clear_blocked()),
            Header(text="Источник поиска"),
            Input(key="bot_username",text="Музыкальный бот — необязательно",default="",subtext="Пусто — источник из конфигурации Telegram",icon="msg_search"),
            Divider(text="Интересы и коллекция хранятся на этом устройстве отдельно для каждого аккаунта. Музыкальный бот получает поисковые запросы. Сердце штатного плеера относится к функциям Telegram; для нашего «Любимого» используй сердце в плагине."),
        ]
